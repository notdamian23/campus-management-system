rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/profiles/$(request.auth.uid);
    }

    function userProfilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }

    function eventPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId);
    }

    function paymentPath(paymentId) {
      return /databases/$(database)/documents/payments/$(paymentId);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function profile() {
      return hasProfile() ? get(profilePath()).data : null;
    }

    function role() {
      return hasProfile() ? profile().role : "";
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && role() == "admin";
    }

    function isTeacher() {
      return signedIn() && role() == "teacher";
    }

    function isRegularECMemberRole(value) {
      return value == "ec" || value == "ecmember";
    }

    function isBodRole(value) {
      return value == "bod";
    }

    function isECMemberRole(value) {
      return isRegularECMemberRole(value) || isBodRole(value);
    }

    function isStudentAudienceRole(value) {
      return value == "student" || isBodRole(value);
    }

    function isStudentOnlyRole(value) {
      return value == "student";
    }

    function hasStudentIdentityFields(data) {
      return data != null &&
        (
          (data.schoolId is string && data.schoolId != "") ||
          (data.schoolIdKey is string && data.schoolIdKey != "") ||
          (data.studentId is string && data.studentId != "")
        );
    }

    function hasStudentSelfIdentity() {
      return hasProfile() &&
        (
          role() == "student" ||
          profile().isStudent == true ||
          isECMemberRole(role())
        ) &&
        hasStudentIdentityFields(profile());
    }

    function targetHasStudentSelfIdentity(uid) {
      return exists(userProfilePath(uid)) &&
        (
          get(userProfilePath(uid)).data.role == "student" ||
          get(userProfilePath(uid)).data.isStudent == true ||
          isECMemberRole(get(userProfilePath(uid)).data.role)
        ) &&
        hasStudentIdentityFields(get(userProfilePath(uid)).data);
    }

    function normalizeCourseScopeValue(value) {
      return !(value is string) || value == "" ? null :
        value.matches("^([Mm]echanical([ -]?[Ee]ngineering)?|[Mm][.]?[Ee][.]?|[Bb][Ss][Mm][Ee])$") ? "Mechanical Engineering" :
        value.matches("^([Ee]lectrical([ -]?[Ee]ngineering)?|[Ee][.]?[Ee][.]?|[Bb][Ss][Ee][Ee])$") ? "Electrical Engineering" :
        value.matches("^([Ee]lectronics([ -]?[Ee]ngineering)?|[Ee]lectronics[ -]?[Aa]nd[ -]?[Cc]ommunications([ -]?[Ee]ngineering)?|[Ee][.]?[Cc][.]?[Ee][.]?|[Bb][Ss][Ee][Cc][Ee])$") ? "Electronics Engineering" :
        value.matches("^([Cc]omputer([ -]?[Ee]ngineering)?|[Cc][.]?[Pp][.]?[Ee][.]?|[Bb][Ss][Cc][Pp][Ee])$") ? "Computer Engineering" :
        value.matches("^([Ii]ndustrial([ -]?[Ee]ngineering)?|[Ii][.]?[Ee][.]?|[Bb][Ss][Ii][Ee])$") ? "Industrial Engineering" :
        null;
    }

    function isEC() {
      return signedIn() && isECMemberRole(role());
    }

    function inferCourseScopeFromPosition(position) {
      return position == "B.O.D. (ME)" ? "Mechanical Engineering" :
        position == "B.O.D. (EE)" ? "Electrical Engineering" :
        position == "B.O.D. (IE)" ? "Industrial Engineering" :
        position == "B.O.D. (CPE)" ? "Computer Engineering" :
        position == "B.O.D. (ECE)" ? "Electronics Engineering" :
        null;
    }

    function courseScopeFromAssignedCourse(courseCode) {
      return normalizeCourseScopeValue(courseCode);
    }

    function currentCourseScope() {
      return !hasProfile() ? null :
        normalizeCourseScopeValue(profile().courseScope) != null ?
        normalizeCourseScopeValue(profile().courseScope) :
        normalizeCourseScopeValue(profile().courseScopeLabel) != null ?
        normalizeCourseScopeValue(profile().courseScopeLabel) :
        courseScopeFromAssignedCourse(profile().assignedCourse) != null ?
        courseScopeFromAssignedCourse(profile().assignedCourse) :
        (
          (profile().ecScope == "course" || role() == "bod") &&
          normalizeCourseScopeValue(profile().course) != null
        ) ?
        normalizeCourseScopeValue(profile().course) :
        inferCourseScopeFromPosition(profile().ecPosition);
    }

    function isBOD() {
      return hasProfile() &&
        (
          role() == "bod" ||
          profile().ecScope == "course" ||
          profile().isBod == true ||
          (
            profile().ecPosition is string &&
            profile().ecPosition.matches("^B\\.O\\.D\\..*")
          ) ||
          courseScopeFromAssignedCourse(profile().assignedCourse) != null ||
          inferCourseScopeFromPosition(profile().ecPosition) != null
        );
    }

    function isRegularEC() {
      return hasProfile() &&
        isRegularECMemberRole(role()) &&
        profile().ecScope == "all" &&
        !isBOD();
    }

    function isAdminOrEC() {
      return isAdmin() || isEC();
    }

    function isAdminOrRegularEC() {
      return isAdmin() || isRegularEC();
    }

    function canManageStudentData(data) {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          currentCourseScope() != null &&
          normalizeCourseScopeValue(data.course) == currentCourseScope()
        );
    }

    function canManageStudentProjectionUpdate() {
      return canManageStudentData(resource.data) &&
        canManageStudentData(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "uid",
          "studentId",
          "schoolId",
          "schoolIdKey",
          "studentName",
          "name",
          "fullName",
          "course",
          "year",
          "yearLevel",
          "status",
          "readyForClearance",
          "updatedAt",
          "fingerprintStatus",
          "fingerprintTemplateId",
          "templateId",
        ]);
    }

    function canManageStudentProfileUpdate() {
      return resource.data.role == "student" &&
        request.resource.data.role == resource.data.role &&
        (
          isAdminOrRegularEC() ||
          (
            isBOD() &&
            currentCourseScope() != null &&
            normalizeCourseScopeValue(resource.data.course) == currentCourseScope() &&
            normalizeCourseScopeValue(request.resource.data.course) == currentCourseScope()
          )
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "schoolId",
          "schoolIdKey",
          "name",
          "fullName",
          "studentName",
          "course",
          "year",
          "yearLevel",
          "status",
          "readyForClearance",
          "updatedAt",
        ]);
    }

    function canManageStudentNotification(targetUid) {
      return targetHasStudentSelfIdentity(targetUid) &&
        (
          isAdminOrRegularEC() ||
          (
            isBOD() &&
            currentCourseScope() != null &&
            normalizeCourseScopeValue(get(userProfilePath(targetUid)).data.course) == currentCourseScope()
          )
        );
    }

    function notificationCourseScope(data) {
      return normalizeCourseScopeValue(data.course) != null ?
        normalizeCourseScopeValue(data.course) :
        (
          data.courses is list &&
          data.courses.size() == 1 &&
          normalizeCourseScopeValue(data.courses[0]) != null
        ) ?
        normalizeCourseScopeValue(data.courses[0]) :
        null;
    }

    function notificationCoursesStayInScope(data) {
      return !(data.courses is list) ||
        data.courses.size() == 0 ||
        (
          data.courses.size() == 1 &&
          normalizeCourseScopeValue(data.courses[0]) == currentCourseScope()
        );
    }

    function canTargetBodNotificationPath(uid) {
      return isBOD() &&
        currentCourseScope() != null &&
        (
          isSelf(uid) ||
          canManageStudentNotification(uid)
        );
    }

    function bodNotificationWriteIsScoped(uid, data) {
      return canTargetBodNotificationPath(uid) &&
        data.createdByUid == request.auth.uid &&
        notificationCourseScope(data) == currentCourseScope() &&
        notificationCoursesStayInScope(data);
    }

    function canManageExistingBodNotification(uid, data) {
      return canTargetBodNotificationPath(uid) &&
        data.createdByUid == request.auth.uid;
    }

    function selfProfileUpdateKeepsAccessAssignments() {
      return request.resource.data.role == resource.data.role &&
        request.resource.data.ecPosition == resource.data.ecPosition &&
        request.resource.data.ecScope == resource.data.ecScope &&
        request.resource.data.assignedCourse == resource.data.assignedCourse &&
        request.resource.data.courseScope == resource.data.courseScope &&
        request.resource.data.courseScopeLabel == resource.data.courseScopeLabel &&
        request.resource.data.isBod == resource.data.isBod &&
        request.resource.data.isStudent == resource.data.isStudent;
    }

    function eventOwnerType(data) {
      return data.ownerType == "bod" ? "bod" : "ec";
    }

    function eventCourseScope(data) {
      return normalizeCourseScopeValue(data.courseScope) != null ?
        normalizeCourseScopeValue(data.courseScope) :
        normalizeCourseScopeValue(data.createdByCourseScope) != null ?
        normalizeCourseScopeValue(data.createdByCourseScope) :
        normalizeCourseScopeValue(data.course);
    }

    function eventSelectedStudentIds(data) {
      return data.selectedStudentIds is list ? data.selectedStudentIds : [];
    }

    function eventSelectedSchoolIds(data) {
      return data.selectedSchoolIds is list ? data.selectedSchoolIds : [];
    }

    function bodCreateBaseIsScoped(data) {
      return isBOD() &&
        currentCourseScope() != null &&
        data.ownerType == "bod" &&
        data.createdBy == request.auth.uid &&
        normalizeCourseScopeValue(data.course) == currentCourseScope() &&
        normalizeCourseScopeValue(data.courseScope) == currentCourseScope() &&
        normalizeCourseScopeValue(data.createdByCourseScope) == currentCourseScope() &&
        data.courses is list &&
        data.courses.size() == 1 &&
        data.courses[0] == currentCourseScope();
    }

    function bodNoSelectedAudienceCreateIsScoped(data) {
      return (
        !("selectedStudentIds" in data) ||
        (data.selectedStudentIds is list && data.selectedStudentIds.size() == 0)
      ) &&
        (
          !("selectedSchoolIds" in data) ||
          (data.selectedSchoolIds is list && data.selectedSchoolIds.size() == 0)
        ) &&
        (
          !("targetStudent" in data) ||
          data.targetStudent == ""
        );
    }

    function bodSelectedStudentAtMatchesScope(studentIds, schoolIds, index) {
      return studentIds.size() <= index ||
        (
          exists(userProfilePath(studentIds[index])) &&
          isStudentAudienceRole(get(userProfilePath(studentIds[index])).data.role) &&
          normalizeCourseScopeValue(get(userProfilePath(studentIds[index])).data.course) == currentCourseScope() &&
          (
            schoolIds.size() == 0 ||
            (
              schoolIds.size() > index &&
              get(userProfilePath(studentIds[index])).data.schoolId == schoolIds[index]
            )
          )
        );
    }

    function bodSelectedAudienceCreateIsScoped(data) {
      let studentIds = eventSelectedStudentIds(data);
      let schoolIds = eventSelectedSchoolIds(data);

      return "selectedStudentIds" in data &&
        data.selectedStudentIds is list &&
        studentIds.size() >= 1 &&
        studentIds.size() <= 9 &&
        (schoolIds.size() == 0 || schoolIds.size() == studentIds.size()) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 0) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 1) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 2) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 3) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 4) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 5) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 6) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 7) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 8) &&
        (
          !("targetStudent" in data) ||
          data.targetStudent == "" ||
          data.targetStudent.matches("^Specific students selected \\([1-9][0-9]*\\)$")
        );
    }

    function bodEventAudienceIsScoped(data) {
      return bodCreateBaseIsScoped(data) &&
        (
          bodNoSelectedAudienceCreateIsScoped(data) ||
          bodSelectedAudienceCreateIsScoped(data)
        );
    }

    function canViewEventData(data) {
      return !isEC() ? signedIn() :
        isAdminOrRegularEC() ||
        (
          isBOD() &&
          (
            eventOwnerType(data) == "ec" ||
            (
              currentCourseScope() != null &&
              eventCourseScope(data) == currentCourseScope()
            )
          )
        );
    }

    function canCreateEventData(data) {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          currentCourseScope() != null &&
          bodEventAudienceIsScoped(data)
        );
    }

    function canUpdateEventData() {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          currentCourseScope() != null &&
          eventOwnerType(resource.data) == "bod" &&
          eventCourseScope(resource.data) == currentCourseScope() &&
          resource.data.createdBy == request.auth.uid &&
          bodEventAudienceIsScoped(request.resource.data)
        );
    }

    function canDeleteEventData() {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          currentCourseScope() != null &&
          eventOwnerType(resource.data) == "bod" &&
          eventCourseScope(resource.data) == currentCourseScope() &&
          resource.data.createdBy == request.auth.uid
        );
    }

    function paymentCourseScope(data) {
      return normalizeCourseScopeValue(data.courseScope) != null ?
        normalizeCourseScopeValue(data.courseScope) :
        normalizeCourseScopeValue(data.createdByCourseScope) != null ?
        normalizeCourseScopeValue(data.createdByCourseScope) :
        normalizeCourseScopeValue(data.course) != null ?
        normalizeCourseScopeValue(data.course) :
        null;
    }

    function paymentTargetCourses(data) {
      return data.targetCourses is list ? data.targetCourses : [];
    }

    function paymentTargetCourseAtMatchesScope(data, courseScope, index) {
      return !(data.targetCourses is list) ||
        data.targetCourses.size() <= index ||
        normalizeCourseScopeValue(data.targetCourses[index]) == courseScope;
    }

    function paymentTargetCoursesContainScope(data, courseScope) {
      return data.targetCourses is list &&
        (
          (data.targetCourses.size() > 0 &&
            normalizeCourseScopeValue(data.targetCourses[0]) == courseScope) ||
          (data.targetCourses.size() > 1 &&
            normalizeCourseScopeValue(data.targetCourses[1]) == courseScope) ||
          (data.targetCourses.size() > 2 &&
            normalizeCourseScopeValue(data.targetCourses[2]) == courseScope) ||
          (data.targetCourses.size() > 3 &&
            normalizeCourseScopeValue(data.targetCourses[3]) == courseScope) ||
          (data.targetCourses.size() > 4 &&
            normalizeCourseScopeValue(data.targetCourses[4]) == courseScope)
        );
    }

    function paymentTargetCoursesStayInScope(data) {
      return !(data.targetCourses is list) ||
        data.targetCourses.size() == 0 ||
        (
          data.targetCourses.size() <= 5 &&
          paymentTargetCourseAtMatchesScope(data, currentCourseScope(), 0) &&
          paymentTargetCourseAtMatchesScope(data, currentCourseScope(), 1) &&
          paymentTargetCourseAtMatchesScope(data, currentCourseScope(), 2) &&
          paymentTargetCourseAtMatchesScope(data, currentCourseScope(), 3) &&
          paymentTargetCourseAtMatchesScope(data, currentCourseScope(), 4)
        );
    }

    function bodPaymentWriteIsScoped(data) {
      return normalizeCourseScopeValue(data.courseScope) == currentCourseScope() &&
        data.createdByUid == request.auth.uid &&
        normalizeCourseScopeValue(data.createdByCourseScope) == currentCourseScope() &&
        normalizeCourseScopeValue(data.course) == currentCourseScope() &&
        paymentTargetCoursesStayInScope(data);
    }

    function bodExistingPaymentIsScoped(data) {
      return currentCourseScope() != null &&
        paymentCourseScope(data) == currentCourseScope() &&
        data.createdByUid == request.auth.uid &&
        normalizeCourseScopeValue(data.createdByCourseScope) == currentCourseScope() &&
        normalizeCourseScopeValue(data.course) == currentCourseScope() &&
        paymentTargetCoursesStayInScope(data);
    }

    function canViewPaymentData(data) {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          currentCourseScope() != null &&
          (
            paymentCourseScope(data) == currentCourseScope() ||
            normalizeCourseScopeValue(data.createdByCourseScope) == currentCourseScope() ||
            normalizeCourseScopeValue(data.course) == currentCourseScope() ||
            paymentTargetCoursesContainScope(data, currentCourseScope())
          )
        );
    }

    function canCreatePaymentData(data) {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          currentCourseScope() != null &&
          bodPaymentWriteIsScoped(data)
        );
    }

    function canUpdatePaymentData() {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          currentCourseScope() != null &&
          bodExistingPaymentIsScoped(resource.data) &&
          bodPaymentWriteIsScoped(request.resource.data)
        );
    }

    function canDeletePaymentData() {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          currentCourseScope() != null &&
          bodExistingPaymentIsScoped(resource.data)
        );
    }

    function selfPaymentAssignmentPath(paymentId) {
      return /databases/$(database)/documents/payments/$(paymentId)/students/$(request.auth.uid);
    }

    function hasSelfPaymentAssignment(paymentId) {
      return signedIn() && exists(selfPaymentAssignmentPath(paymentId));
    }

    function canManagePaymentStudentData(paymentId, data) {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          currentCourseScope() != null &&
          normalizeCourseScopeValue(data.course) == currentCourseScope() &&
          exists(paymentPath(paymentId)) &&
          bodExistingPaymentIsScoped(get(paymentPath(paymentId)).data)
        );
    }

    function canDeletePaymentStudentData(paymentId, data) {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          currentCourseScope() != null &&
          normalizeCourseScopeValue(data.course) == currentCourseScope() &&
          exists(paymentPath(paymentId)) &&
          paymentCourseScope(get(paymentPath(paymentId)).data) == currentCourseScope() &&
          get(paymentPath(paymentId)).data.createdByUid == request.auth.uid &&
          normalizeCourseScopeValue(get(paymentPath(paymentId)).data.createdByCourseScope) == currentCourseScope() &&
          normalizeCourseScopeValue(get(paymentPath(paymentId)).data.course) == currentCourseScope()
        );
    }

    function ecDocumentOwnerType(data) {
      return data.ownerType == "bod" ? "bod" : "ec";
    }

    function ecDocumentCourseScope(data) {
      return normalizeCourseScopeValue(data.courseScope) != null ?
        normalizeCourseScopeValue(data.courseScope) :
        normalizeCourseScopeValue(data.createdByCourseScope);
    }

    function ecDocumentStrictCourseScope(data) {
      return normalizeCourseScopeValue(data.courseScope);
    }

    function ecDocumentCreatedByUid(data) {
      return data.createdBy != null && data.createdBy != "" ? data.createdBy :
        (
          data.createdByUid != null &&
          data.createdByUid != ""
        ) ? data.createdByUid :
        (
          data.uploadedByUid != null &&
          data.uploadedByUid != ""
        ) ? data.uploadedByUid :
        (
          data.ownerUid != null &&
          data.ownerUid != ""
        ) ? data.ownerUid :
        "";
    }

    function canManageOwnBodEcDocumentData(data) {
      return isBOD() &&
        currentCourseScope() != null &&
        ecDocumentOwnerType(data) == "bod" &&
        ecDocumentCreatedByUid(data) == request.auth.uid &&
        ecDocumentStrictCourseScope(data) == currentCourseScope();
    }

    function canViewEcDocumentData(data) {
      return isAdminOrRegularEC() || canManageOwnBodEcDocumentData(data);
    }

    function enrollmentSessionCourseScope(data) {
      return normalizeCourseScopeValue(data.courseScope) != null ?
        normalizeCourseScopeValue(data.courseScope) :
        normalizeCourseScopeValue(data.createdByCourseScope);
    }

    function canViewEnrollmentSessionData(data) {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          currentCourseScope() != null &&
          enrollmentSessionCourseScope(data) == currentCourseScope()
        );
    }

    match /profiles/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        canManageStudentProfileUpdate() ||
        (isSelf(uid) && selfProfileUpdateKeepsAccessAssignments());
      allow delete: if isAdmin();

      match /documents/{docId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update, delete: if (isSelf(uid) && isEC()) || isAdmin();
      }

      match /notifications/{notificationId} {
        allow read: if (isSelf(uid) && hasStudentSelfIdentity()) || isAdminOrRegularEC() ||
          (isBOD() && canManageStudentNotification(uid));
        allow create: if isAdminOrRegularEC() ||
          bodNotificationWriteIsScoped(uid, request.resource.data);
        allow update: if isAdminOrRegularEC() ||
          (
            canManageExistingBodNotification(uid, resource.data) &&
            bodNotificationWriteIsScoped(uid, request.resource.data)
          );
        allow delete: if isAdminOrRegularEC() ||
          canManageExistingBodNotification(uid, resource.data);
      }
    }

    match /logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if signedIn() && canViewEventData(resource.data);
      allow create: if signedIn() && canCreateEventData(request.resource.data);
      allow update: if signedIn() && canUpdateEventData();
      allow delete: if signedIn() && canDeleteEventData();

      match /images/{imageId} {
        allow read: if signedIn() && canViewEventData(get(eventPath(eventId)).data);
        allow create, update, delete: if signedIn() &&
          (
            isAdminOrRegularEC() ||
            (
              isBOD() &&
              currentCourseScope() != null &&
              eventOwnerType(get(eventPath(eventId)).data) == "bod" &&
              eventCourseScope(get(eventPath(eventId)).data) == currentCourseScope() &&
              get(eventPath(eventId)).data.createdBy == request.auth.uid
            )
          );
      }

      match /docs/{docId} {
        allow read: if isTeacher() || (
          signedIn() && canViewEventData(get(eventPath(eventId)).data)
        );
        allow create, update, delete: if signedIn() &&
          (
            isAdminOrRegularEC() ||
            (
              isBOD() &&
              currentCourseScope() != null &&
              eventOwnerType(get(eventPath(eventId)).data) == "bod" &&
              eventCourseScope(get(eventPath(eventId)).data) == currentCourseScope() &&
              get(eventPath(eventId)).data.createdBy == request.auth.uid
            )
          );
      }

      match /attendance/{uid} {
        allow read: if isAdminOrRegularEC() || isTeacher() ||
          (isSelf(uid) && hasStudentSelfIdentity()) ||
          (
            isBOD() &&
            currentCourseScope() != null &&
            normalizeCourseScopeValue(resource.data.course) == currentCourseScope() &&
            canViewEventData(get(eventPath(eventId)).data)
          );
        allow create, update, delete: if isAdminOrRegularEC() ||
          (
            isBOD() &&
            currentCourseScope() != null &&
            normalizeCourseScopeValue(request.resource.data.course) == currentCourseScope() &&
            (
              !exists(/databases/$(database)/documents/events/$(eventId)/attendance/$(uid)) ||
              normalizeCourseScopeValue(resource.data.course) == currentCourseScope()
            ) &&
            eventOwnerType(get(eventPath(eventId)).data) == "bod" &&
            eventCourseScope(get(eventPath(eventId)).data) == currentCourseScope() &&
            get(eventPath(eventId)).data.createdBy == request.auth.uid
          );
      }

      match /registrations/{uid} {
        allow read: if isAdminOrRegularEC() ||
          (isSelf(uid) && hasStudentSelfIdentity()) ||
          (
            isBOD() &&
            currentCourseScope() != null &&
            normalizeCourseScopeValue(resource.data.course) == currentCourseScope() &&
            canViewEventData(get(eventPath(eventId)).data)
          );
        allow create, update, delete: if isAdminOrRegularEC() ||
          (
            isBOD() &&
            currentCourseScope() != null &&
            normalizeCourseScopeValue(request.resource.data.course) == currentCourseScope() &&
            (
              !exists(/databases/$(database)/documents/events/$(eventId)/registrations/$(uid)) ||
              normalizeCourseScopeValue(resource.data.course) == currentCourseScope()
            ) &&
            eventOwnerType(get(eventPath(eventId)).data) == "bod" &&
            eventCourseScope(get(eventPath(eventId)).data) == currentCourseScope() &&
            get(eventPath(eventId)).data.createdBy == request.auth.uid
          );
      }

      match /{subcollection}/{docId} {
        allow read, create, update, delete: if isAdminOrRegularEC();
      }
    }

    match /payments/{paymentId} {
      allow read: if signedIn() &&
        (
          canViewPaymentData(resource.data) ||
          hasSelfPaymentAssignment(paymentId)
        );
      allow create: if signedIn() && canCreatePaymentData(request.resource.data);
      allow update: if signedIn() && canUpdatePaymentData();
      allow delete: if signedIn() && canDeletePaymentData();

      match /students/{studentUid} {
        allow read: if isAdminOrRegularEC() ||
          (isSelf(studentUid) && hasStudentSelfIdentity()) ||
          (
            signedIn() &&
            resource.data.uid == request.auth.uid &&
            hasStudentSelfIdentity()
          ) ||
          (
            isBOD() &&
            currentCourseScope() != null &&
            normalizeCourseScopeValue(resource.data.course) == currentCourseScope()
          );
        allow create: if canManagePaymentStudentData(paymentId, request.resource.data);
        allow update: if canManagePaymentStudentData(paymentId, resource.data) &&
          canManagePaymentStudentData(paymentId, request.resource.data);
        allow delete: if canDeletePaymentStudentData(paymentId, resource.data);
      }
    }

    match /ecDocuments/{docId} {
      allow read: if signedIn() && canViewEcDocumentData(resource.data);
      allow create: if isAdminOrRegularEC() ||
        canManageOwnBodEcDocumentData(request.resource.data);
      allow update: if isAdminOrRegularEC() ||
        (
          canManageOwnBodEcDocumentData(resource.data) &&
          canManageOwnBodEcDocumentData(request.resource.data)
        );
      allow delete: if isAdminOrRegularEC() ||
        canManageOwnBodEcDocumentData(resource.data);
    }

    match /students/{studentId} {
      allow read: if isTeacher() ||
        (isSelf(studentId) && hasStudentSelfIdentity()) ||
        canManageStudentData(resource.data);
      allow create: if isAdminOrRegularEC() ||
        (
          isBOD() &&
          currentCourseScope() != null &&
          canManageStudentData(request.resource.data)
        );
      allow update: if isAdminOrRegularEC() ||
        (
          isBOD() &&
          currentCourseScope() != null &&
          canManageStudentData(resource.data) &&
          canManageStudentData(request.resource.data)
        );
      allow delete: if isAdminOrRegularEC() ||
        (
          isBOD() &&
          currentCourseScope() != null &&
          canManageStudentData(resource.data)
        );
    }

    match /devices/{deviceId} {
      allow read, write: if isAdmin();

      match /syncLogs/{logId} {
        allow read: if isAdminOrEC();
        allow write: if false;
      }
    }

    match /devicePairings/{deviceId} {
      allow read: if isAdminOrEC();
      allow create, update, delete: if isAdminOrEC();
    }

    match /enrollmentSessions/{sessionId} {
      allow read: if canViewEnrollmentSessionData(resource.data);
      allow create, update, delete: if isAdminOrRegularEC();

      match /students/{studentId} {
        allow read: if canViewEnrollmentSessionData(
          get(/databases/$(database)/documents/enrollmentSessions/$(sessionId)).data
        );
        allow create, update, delete: if isAdminOrRegularEC();
      }
    }

    match /enrollmentQueue/{queueId} {
      allow read, create, update, delete: if isAdminOrRegularEC();
    }

    match /fingerprintTemplates/{templateId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /moduleCleanupQueue/{cleanupId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /syncLogs/{logId} {
      allow read: if isAdminOrEC();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
