rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/profiles/$(request.auth.uid);
    }

    function userProfilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }

    function userProfileExists(uid) {
      return exists(userProfilePath(uid));
    }

    function userProfileDoc(uid) {
      return get(userProfilePath(uid)).data;
    }

    function eventPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId);
    }

    function paymentPath(paymentId) {
      return /databases/$(database)/documents/payments/$(paymentId);
    }

    function paymentExists(paymentId) {
      return exists(paymentPath(paymentId));
    }

    function paymentDoc(paymentId) {
      return get(paymentPath(paymentId)).data;
    }

    function currentProfileData() {
      return signedIn() && userProfileExists(request.auth.uid) ?
        userProfileDoc(request.auth.uid) :
        null;
    }

    function hasProfile() {
      return currentProfileData() != null;
    }

    function profile() {
      return currentProfileData();
    }

    function profileRole(data) {
      return data != null && data.role is string ? data.role : "";
    }

    function currentRole() {
      return profileRole(currentProfileData());
    }

    function role() {
      return currentRole();
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentIsAdmin() {
      return currentRole() == "admin";
    }

    function isAdmin() {
      return currentIsAdmin();
    }

    function currentIsTeacher() {
      return currentRole() == "teacher";
    }

    function isTeacher() {
      return currentIsTeacher();
    }

    function isRegularECMemberRole(value) {
      return value == "ec" || value == "ecmember";
    }

    function isBodRole(value) {
      return value == "bod";
    }

    function isECMemberRole(value) {
      return isRegularECMemberRole(value) || isBodRole(value);
    }

    function isStudentOnlyRole(value) {
      return value == "student";
    }

    function hasStudentIdentityFields(data) {
      return data != null &&
        (
          (data.schoolId is string && data.schoolId != "") ||
          (data.schoolIdKey is string && data.schoolIdKey != "") ||
          (data.studentId is string && data.studentId != "")
        );
    }

    function dataHasStudentIdentityWithRole(data, roleValue) {
      return data != null &&
        hasStudentIdentityFields(data) &&
        (
          roleValue == "student" ||
          data.isStudent == true ||
          isECMemberRole(roleValue)
        );
    }

    function dataHasStudentIdentity(data) {
      return dataHasStudentIdentityWithRole(data, profileRole(data));
    }

    function currentHasStudentIdentity() {
      let data = currentProfileData();
      let roleValue = profileRole(data);

      return dataHasStudentIdentityWithRole(data, roleValue);
    }

    function hasStudentSelfIdentity() {
      return currentHasStudentIdentity();
    }

    function studentProfileHasIdentity(data) {
      return dataHasStudentIdentity(data);
    }

    function normalizeCourseScopeValue(value) {
      return value == "ME" ||
        value == "BSME" ||
        value == "Mechanical Engineering" ||
        value == "mechanical-engineering" ? "Mechanical Engineering" :
        value == "EE" ||
        value == "BSEE" ||
        value == "Electrical Engineering" ||
        value == "electrical-engineering" ? "Electrical Engineering" :
        value == "IE" ||
        value == "BSIE" ||
        value == "Industrial Engineering" ||
        value == "industrial-engineering" ? "Industrial Engineering" :
        value == "CPE" ||
        value == "BSCpE" ||
        value == "BSCPE" ||
        value == "Computer Engineering" ||
        value == "computer-engineering" ? "Computer Engineering" :
        value == "ECE" ||
        value == "BSECE" ||
        value == "Electronics Engineering" ||
        value == "electronics-engineering" ? "Electronics Engineering" :
        "";
    }

    function firstCourseScopeValue(primary, secondary, tertiary) {
      let primaryScope = normalizeCourseScopeValue(primary);
      let secondaryScope = normalizeCourseScopeValue(secondary);
      let tertiaryScope = normalizeCourseScopeValue(tertiary);

      return primaryScope != "" ? primaryScope :
        secondaryScope != "" ? secondaryScope :
        tertiaryScope;
    }

    function isEC() {
      return signedIn() && isECMemberRole(role());
    }

    function inferCourseScopeFromPosition(position) {
      return position == "B.O.D. (ME)" ? "Mechanical Engineering" :
        position == "B.O.D. (EE)" ? "Electrical Engineering" :
        position == "B.O.D. (IE)" ? "Industrial Engineering" :
        position == "B.O.D. (CPE)" ? "Computer Engineering" :
        position == "B.O.D. (ECE)" ? "Electronics Engineering" :
        "";
    }

    function courseScopeFromAssignedCourse(courseCode) {
      return normalizeCourseScopeValue(courseCode);
    }

    function courseScopeFromProfileData(data) {
      let labelScope = normalizeCourseScopeValue(data.courseScopeLabel);
      let courseScope = normalizeCourseScopeValue(data.course);
      let assignedScope = courseScopeFromAssignedCourse(data.assignedCourse);
      let positionScope = inferCourseScopeFromPosition(data.ecPosition);
      let slugScope = normalizeCourseScopeValue(data.courseScope);

      return labelScope != "" ? labelScope :
        courseScope != "" ? courseScope :
        assignedScope != "" ? assignedScope :
        positionScope != "" ? positionScope :
        slugScope;
    }

    function courseScopeSlug(courseScope) {
      return courseScope == "Mechanical Engineering" ? "mechanical-engineering" :
        courseScope == "Electrical Engineering" ? "electrical-engineering" :
        courseScope == "Industrial Engineering" ? "industrial-engineering" :
        courseScope == "Computer Engineering" ? "computer-engineering" :
        courseScope == "Electronics Engineering" ? "electronics-engineering" :
        "";
    }

    function isAllScopeECPosition(position) {
      return position == "President" ||
        position == "Vice President" ||
        position == "Secretary" ||
        position == "Treasurer" ||
        position == "Auditor" ||
        position == "P.I.O." ||
        position == "H.A.S.";
    }

    function isBODPosition(position) {
      return position == "B.O.D." ||
        position == "B.O.D. (ME)" ||
        position == "B.O.D. (EE)" ||
        position == "B.O.D. (IE)" ||
        position == "B.O.D. (CPE)" ||
        position == "B.O.D. (ECE)";
    }

    function hasBodCourseMarkers(data) {
      return data != null && courseScopeFromProfileData(data) != "";
    }

    function isBODProfileDataWithRole(data, roleValue) {
      return data != null &&
        (
          roleValue == "bod" ||
          (
            isECMemberRole(roleValue) &&
            (
              data.ecScope == "course" ||
              (
                data.ecScope != "all" &&
                (
                  data.isBod == true ||
                  isBODPosition(data.ecPosition) ||
                  (
                    !isAllScopeECPosition(data.ecPosition) &&
                    hasBodCourseMarkers(data)
                  )
                )
              )
            )
          )
        );
    }

    function currentCourseScopeFromData(data, roleValue) {
      return isBODProfileDataWithRole(data, roleValue) ?
        courseScopeFromProfileData(data) :
        "";
    }

    function currentCourseScope() {
      let data = currentProfileData();
      let roleValue = profileRole(data);

      return currentCourseScopeFromData(data, roleValue);
    }

    function hasCurrentCourseScope() {
      return currentCourseScope() != "";
    }

    function currentCourseScopeSlug() {
      let courseScope = currentCourseScope();
      return courseScope != "" ? courseScopeSlug(courseScope) : "";
    }

    function valueMatchesCourseScope(value, courseScope) {
      return courseScope != "" &&
        normalizeCourseScopeValue(value) == courseScope;
    }

    function dataCourseMatchesScope(data, courseScope) {
      return data != null &&
        valueMatchesCourseScope(data.course, courseScope);
    }

    function courseMatchesCurrentScope(value) {
      let courseScope = currentCourseScope();
      return valueMatchesCourseScope(value, courseScope);
    }

    function studentRecordMatchesCurrentScope(data) {
      return dataCourseMatchesScope(data, currentCourseScope());
    }

    function bodManageableStudentData(data, courseScope) {
      return data != null &&
        (
          !("role" in data) ||
          isStudentOnlyRole(profileRole(data))
        ) &&
        dataCourseMatchesScope(data, courseScope);
    }

    function studentOnlyProfileMatchesScope(data, courseScope) {
      return data != null &&
        isStudentOnlyRole(profileRole(data)) &&
        dataCourseMatchesScope(data, courseScope);
    }

    function studentOnlyProfileMatchesCurrentScope(data) {
      return studentOnlyProfileMatchesScope(data, currentCourseScope());
    }

    function studentProfileHasIdentityAndMatchesScope(data, courseScope) {
      return dataHasStudentIdentity(data) &&
        dataCourseMatchesScope(data, courseScope);
    }

    function studentProfileHasIdentityAndMatchesCurrentScope(data) {
      return studentProfileHasIdentityAndMatchesScope(data, currentCourseScope());
    }

    function isBODProfileData(data) {
      return isBODProfileDataWithRole(data, profileRole(data));
    }

    function isRegularECProfileDataWithRole(data, roleValue) {
      return data != null &&
        isRegularECMemberRole(roleValue) &&
        (data.ecScope == "all" || !isBODProfileDataWithRole(data, roleValue));
    }

    function isRegularECProfileData(data) {
      return isRegularECProfileDataWithRole(data, profileRole(data));
    }

    function currentIsBod() {
      let data = currentProfileData();
      let roleValue = profileRole(data);

      return isBODProfileDataWithRole(data, roleValue);
    }

    function isBOD() {
      return currentIsBod();
    }

    function currentIsRegularEC() {
      let data = currentProfileData();
      let roleValue = profileRole(data);

      return isRegularECProfileDataWithRole(data, roleValue);
    }

    function isRegularEC() {
      return currentIsRegularEC();
    }

    function isAdminOrEC() {
      return isAdmin() || isEC();
    }

    function currentIsAdminOrRegularEC() {
      return currentIsAdmin() || currentIsRegularEC();
    }

    function isAdminOrRegularEC() {
      return currentIsAdminOrRegularEC();
    }

    function canManageStudentData(data) {
      let currentData = currentProfileData();
      let currentRoleValue = profileRole(currentData);
      let courseScope = currentCourseScopeFromData(currentData, currentRoleValue);

      return currentRoleValue == "admin" ||
        isRegularECProfileDataWithRole(currentData, currentRoleValue) ||
        bodManageableStudentData(data, courseScope);
    }

    function canManageStudentProfileUpdateData(oldData, newData) {
      let currentData = currentProfileData();
      let currentRoleValue = profileRole(currentData);
      let courseScope = currentCourseScopeFromData(currentData, currentRoleValue);

      return oldData != null &&
        newData != null &&
        profileRole(oldData) == "student" &&
        profileRole(newData) == profileRole(oldData) &&
        (
          currentRoleValue == "admin" ||
          isRegularECProfileDataWithRole(currentData, currentRoleValue) ||
          (
            courseScope != "" &&
            dataCourseMatchesScope(oldData, courseScope) &&
            dataCourseMatchesScope(newData, courseScope)
          )
        ) &&
        newData.diff(oldData).affectedKeys().hasOnly([
          "schoolId",
          "schoolIdKey",
          "name",
          "fullName",
          "studentName",
          "course",
          "year",
          "yearLevel",
          "status",
          "readyForClearance",
          "updatedAt",
        ]);
    }

    function canReadStudentProfileData(data) {
      let currentData = currentProfileData();
      let currentRoleValue = profileRole(currentData);
      let courseScope = currentCourseScopeFromData(currentData, currentRoleValue);

      return currentRoleValue == "admin" ||
        isRegularECProfileDataWithRole(currentData, currentRoleValue) ||
        studentOnlyProfileMatchesScope(data, courseScope);
    }

    function notificationCourseScope(data) {
      let directCourseScope = normalizeCourseScopeValue(data.course);
      let listCourseScope = data.courses is list && data.courses.size() == 1 ?
        normalizeCourseScopeValue(data.courses[0]) :
        "";

      return directCourseScope != "" ? directCourseScope : listCourseScope;
    }

    function notificationCoursesStayInScope(data, courseScope) {
      let courses = data.courses is list ? data.courses : [];

      return courses.size() == 0 ||
        (
          courses.size() == 1 &&
          valueMatchesCourseScope(courses[0], courseScope)
        );
    }

    function bodNotificationTargetProfileMatchesScope(uid, courseScope) {
      return courseScope != "" &&
        userProfileExists(uid) &&
        studentOnlyProfileMatchesScope(userProfileDoc(uid), courseScope);
    }

    function canReadBodNotification(uid) {
      let currentData = currentProfileData();
      let currentRoleValue = profileRole(currentData);
      let courseScope = currentCourseScopeFromData(currentData, currentRoleValue);

      return bodNotificationTargetProfileMatchesScope(uid, courseScope);
    }

    function canManageBodNotificationTarget(uid, courseScope) {
      return courseScope != "" &&
        (
          isSelf(uid) ||
          bodNotificationTargetProfileMatchesScope(uid, courseScope)
        );
    }

    function bodNotificationDataIsScoped(data, courseScope) {
      return data != null &&
        data.createdByUid == request.auth.uid &&
        valueMatchesCourseScope(notificationCourseScope(data), courseScope) &&
        notificationCoursesStayInScope(data, courseScope);
    }

    function canCreateBodNotification(uid, newData) {
      let currentData = currentProfileData();
      let currentRoleValue = profileRole(currentData);
      let courseScope = currentCourseScopeFromData(currentData, currentRoleValue);

      return canManageBodNotificationTarget(uid, courseScope) &&
        bodNotificationDataIsScoped(newData, courseScope);
    }

    function canUpdateBodNotification(uid, oldData, newData) {
      let currentData = currentProfileData();
      let currentRoleValue = profileRole(currentData);
      let courseScope = currentCourseScopeFromData(currentData, currentRoleValue);

      return canManageBodNotificationTarget(uid, courseScope) &&
        oldData.createdByUid == request.auth.uid &&
        bodNotificationDataIsScoped(newData, courseScope);
    }

    function canDeleteBodNotification(uid, oldData) {
      let currentData = currentProfileData();
      let currentRoleValue = profileRole(currentData);
      let courseScope = currentCourseScopeFromData(currentData, currentRoleValue);

      return canManageBodNotificationTarget(uid, courseScope) &&
        oldData.createdByUid == request.auth.uid;
    }

    function selfProfileUpdateKeepsAccessAssignments(oldData, newData) {
      return oldData != null &&
        newData != null &&
        profileRole(newData) == profileRole(oldData) &&
        newData.ecPosition == oldData.ecPosition &&
        newData.ecScope == oldData.ecScope &&
        newData.assignedCourse == oldData.assignedCourse &&
        newData.courseScope == oldData.courseScope &&
        newData.courseScopeLabel == oldData.courseScopeLabel &&
        newData.isBod == oldData.isBod &&
        newData.isStudent == oldData.isStudent;
    }

    function eventOwnerType(data) {
      return data.ownerType == "bod" ? "bod" : "ec";
    }

    function eventCreatedByUidValue(data) {
      return data.createdByUid is string && data.createdByUid != "" ? data.createdByUid :
        (
          data.createdBy is string &&
          data.createdBy != ""
        ) ? data.createdBy :
        "";
    }

    function eventCreatedByMatchesCurrentUser(data) {
      return data != null &&
        eventCreatedByUidValue(data) == request.auth.uid;
    }

    function eventCourseScope(data) {
      return firstCourseScopeValue(
        data.courseScope,
        data.createdByCourseScope,
        data.course
      );
    }

    function eventSelectedStudentIds(data) {
      return data.selectedStudentIds is list ? data.selectedStudentIds : [];
    }

    function eventSelectedSchoolIds(data) {
      return data.selectedSchoolIds is list ? data.selectedSchoolIds : [];
    }

    function bodCreateBaseIsScoped(data) {
      let courseScope = currentCourseScope();
      let course = normalizeCourseScopeValue(data.course);
      let ownerCourseScope = normalizeCourseScopeValue(data.courseScope);
      let creatorCourseScope = normalizeCourseScopeValue(data.createdByCourseScope);

      return isBOD() &&
        courseScope != "" &&
        data.ownerType == "bod" &&
        data.createdBy == request.auth.uid &&
        course == courseScope &&
        ownerCourseScope == courseScope &&
        creatorCourseScope == courseScope &&
        data.courses is list &&
        data.courses.size() == 1 &&
        data.courses[0] == courseScope;
    }

    function bodNoSelectedAudienceCreateIsScoped(data) {
      return (
        !("selectedStudentIds" in data) ||
        (data.selectedStudentIds is list && data.selectedStudentIds.size() == 0)
      ) &&
        (
          !("selectedSchoolIds" in data) ||
          (data.selectedSchoolIds is list && data.selectedSchoolIds.size() == 0)
        ) &&
        (
          !("targetStudent" in data) ||
          data.targetStudent == ""
        );
    }

    function bodSelectedStudentProfileMatchesScope(data, expectedSchoolId) {
      return studentOnlyProfileMatchesCurrentScope(data) &&
        (
          expectedSchoolId == "" ||
          data.schoolId == expectedSchoolId
        );
    }

    function bodSelectedStudentAtMatchesScope(studentIds, schoolIds, index) {
      return studentIds.size() <= index ||
        (
          exists(userProfilePath(studentIds[index])) &&
          bodSelectedStudentProfileMatchesScope(
            get(userProfilePath(studentIds[index])).data,
            schoolIds.size() > index ? schoolIds[index] : ""
          )
        );
    }

    function bodSelectedAudienceIdsAreScoped(studentIds, schoolIds) {
      return bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 0) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 1) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 2) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 3) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 4) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 5) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 6) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 7) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 8);
    }

    function bodSelectedAudienceCreateIsScoped(data) {
      let studentIds = eventSelectedStudentIds(data);
      let schoolIds = eventSelectedSchoolIds(data);

      return "selectedStudentIds" in data &&
        data.selectedStudentIds is list &&
        studentIds.size() >= 1 &&
        studentIds.size() <= 9 &&
        (schoolIds.size() == 0 || schoolIds.size() == studentIds.size()) &&
        bodSelectedAudienceIdsAreScoped(studentIds, schoolIds) &&
        (
          !("targetStudent" in data) ||
          data.targetStudent == "" ||
          data.targetStudent.matches("^Specific students selected \\([1-9][0-9]*\\)$")
        );
    }

    function bodEventAudienceIsScoped(data) {
      return bodCreateBaseIsScoped(data) &&
        (
          bodNoSelectedAudienceCreateIsScoped(data) ||
          bodSelectedAudienceCreateIsScoped(data)
        );
    }

    function eventVisibleToBodScope(data, courseScope) {
      return courseScope != "" &&
        (
          eventOwnerType(data) == "ec" ||
          eventCourseScope(data) == courseScope
        );
    }

    function eventManagedByBodScope(data, courseScope) {
      return courseScope != "" &&
        eventOwnerType(data) == "bod" &&
        eventCourseScope(data) == courseScope &&
        eventCreatedByMatchesCurrentUser(data);
    }

    function canViewEventData(data) {
      let currentData = currentProfileData();
      let currentRoleValue = profileRole(currentData);
      let courseScope = currentCourseScopeFromData(currentData, currentRoleValue);

      return !isECMemberRole(currentRoleValue) ? signedIn() :
        currentRoleValue == "admin" ||
        isRegularECProfileDataWithRole(currentData, currentRoleValue) ||
        eventVisibleToBodScope(data, courseScope);
    }

    function canCreateEventData(data) {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          hasCurrentCourseScope() &&
          bodEventAudienceIsScoped(data)
        );
    }

    function canUpdateEventData() {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          hasCurrentCourseScope() &&
          eventOwnerType(resource.data) == "bod" &&
          eventCourseScope(resource.data) == currentCourseScope() &&
          eventCreatedByMatchesCurrentUser(resource.data) &&
          bodEventAudienceIsScoped(request.resource.data)
        );
    }

    function canDeleteEventData() {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          hasCurrentCourseScope() &&
          eventOwnerType(resource.data) == "bod" &&
          eventCourseScope(resource.data) == currentCourseScope() &&
          eventCreatedByMatchesCurrentUser(resource.data)
        );
    }

    function eventDoc(eventId) {
      return get(eventPath(eventId)).data;
    }

    function eventExists(eventId) {
      return exists(eventPath(eventId));
    }

    function canManageOwnBodEventSubcollectionData(data, courseScope) {
      return eventManagedByBodScope(data, courseScope);
    }

    function canReadEventSubcollection(eventId) {
      let currentData = currentProfileData();
      let currentRoleValue = profileRole(currentData);
      let courseScope = currentCourseScopeFromData(currentData, currentRoleValue);

      return signedIn() &&
        eventExists(eventId) &&
        (
          !isECMemberRole(currentRoleValue) ||
          currentRoleValue == "admin" ||
          isRegularECProfileDataWithRole(currentData, currentRoleValue) ||
          eventVisibleToBodScope(eventDoc(eventId), courseScope)
        );
    }

    function canManageEventSubcollection(eventId) {
      let currentData = currentProfileData();
      let currentRoleValue = profileRole(currentData);
      let courseScope = currentCourseScopeFromData(currentData, currentRoleValue);

      return currentRoleValue == "admin" ||
        isRegularECProfileDataWithRole(currentData, currentRoleValue) ||
        (
          eventExists(eventId) &&
          canManageOwnBodEventSubcollectionData(eventDoc(eventId), courseScope)
        );
    }

    function canReadEventDocumentSubcollection(eventId) {
      let currentData = currentProfileData();
      let currentRoleValue = profileRole(currentData);
      let courseScope = currentCourseScopeFromData(currentData, currentRoleValue);

      return signedIn() &&
        eventExists(eventId) &&
        (
          currentRoleValue == "admin" ||
          currentIsTeacher() ||
          isRegularECProfileDataWithRole(currentData, currentRoleValue) ||
          (
            isBODProfileDataWithRole(currentData, currentRoleValue) &&
            canManageOwnBodEventSubcollectionData(eventDoc(eventId), courseScope)
          )
        );
    }

    function eventDocumentStoragePathValue(data) {
      return data.storagePath is string && data.storagePath != "" ? data.storagePath :
        (
          data.path is string &&
          data.path != ""
        ) ? data.path :
        "";
    }

    function eventDocumentStoragePathMatchesEvent(eventId, data) {
      let storagePath = eventDocumentStoragePathValue(data);
      return storagePath != "" &&
        storagePath.matches("^events/" + eventId + "/docs/[^/]+/[^/]+$");
    }

    function isAllowedEventDocumentContentType(contentType) {
      return contentType == "application/pdf" ||
        contentType == "application/msword" ||
        contentType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
    }

    function eventDocumentContentTypeIsAllowed(data) {
      return data.contentType is string &&
        isAllowedEventDocumentContentType(data.contentType);
    }

    function eventDocumentSizeWithinLimit(data) {
      return (
        data.size is int ||
        data.size is float
      ) &&
        data.size >= 0 &&
        data.size <= 10 * 1024 * 1024;
    }

    function eventDocumentUploadedByMatchesCurrentUser(data) {
      return data.uploadedByUid is string &&
        data.uploadedByUid == request.auth.uid;
    }

    function eventDocumentCreatedByMatchesCurrentUser(data) {
      return (data.createdByUid is string && data.createdByUid == request.auth.uid) ||
        (data.createdBy is string && data.createdBy == request.auth.uid) ||
        eventDocumentUploadedByMatchesCurrentUser(data);
    }

    function eventDocumentStatusIsValid(data) {
      return !(data.status is string) ||
        data.status == "pending-upload" ||
        data.status == "active";
    }

    function eventDocumentEventIdMatchesParent(eventId, data) {
      return !(data.eventId is string) || data.eventId == eventId;
    }

    function eventDocumentOwnerTypeMatchesParent(eventId, data) {
      return !(data.ownerType is string) ||
        data.ownerType == eventOwnerType(eventDoc(eventId));
    }

    function eventDocumentMetadataScope(data) {
      return firstCourseScopeValue(
        data.courseScope,
        data.createdByCourseScope,
        data.course
      );
    }

    function eventDocumentBodMetadataMatchesCurrentScope(eventId, data) {
      let courseScope = currentCourseScope();
      let parentEvent = eventDoc(eventId);
      let metadataScope = eventDocumentMetadataScope(data);

      return courseScope != "" &&
        eventOwnerType(parentEvent) == "bod" &&
        eventManagedByBodScope(parentEvent, courseScope) &&
        data.ownerType == "bod" &&
        (metadataScope == "" || metadataScope == courseScope);
    }

    function eventDocumentMetadataIsValid(eventId, data) {
      return data != null &&
        eventDocumentEventIdMatchesParent(eventId, data) &&
        eventDocumentStoragePathMatchesEvent(eventId, data) &&
        eventDocumentStatusIsValid(data) &&
        eventDocumentOwnerTypeMatchesParent(eventId, data) &&
        eventDocumentContentTypeIsAllowed(data) &&
        eventDocumentSizeWithinLimit(data) &&
        eventDocumentCreatedByMatchesCurrentUser(data) &&
        (!isBOD() || eventDocumentBodMetadataMatchesCurrentScope(eventId, data));
    }

    function eventTargetProfileMatchesScope(uid, courseScope) {
      return courseScope != "" &&
        userProfileExists(uid) &&
        studentProfileHasIdentityAndMatchesScope(userProfileDoc(uid), courseScope);
    }

    function eventParticipantMatchesCurrentScope(uid, data, courseScope) {
      return dataCourseMatchesScope(data, courseScope) ||
        eventTargetProfileMatchesScope(uid, courseScope);
    }

    function canReadScopedEventParticipant(eventId, uid, data) {
      let currentData = currentProfileData();
      let currentRoleValue = profileRole(currentData);
      let courseScope = currentCourseScopeFromData(currentData, currentRoleValue);

      return eventExists(eventId) &&
        eventVisibleToBodScope(eventDoc(eventId), courseScope) &&
        eventParticipantMatchesCurrentScope(uid, data, courseScope);
    }

    function canWriteScopedEventParticipant(eventId, currentExists, currentData, nextData) {
      let currentProfile = currentProfileData();
      let currentRoleValue = profileRole(currentProfile);
      let courseScope = currentCourseScopeFromData(currentProfile, currentRoleValue);

      return eventExists(eventId) &&
        nextData != null &&
        dataCourseMatchesScope(nextData, courseScope) &&
        (
          !currentExists ||
          dataCourseMatchesScope(currentData, courseScope)
        ) &&
        eventManagedByBodScope(eventDoc(eventId), courseScope);
    }

    function paymentOwnerType(data) {
      return data.ownerType == "bod" ? "bod" : "ec";
    }

    function paymentCourseScope(data) {
      return firstCourseScopeValue(
        data.courseScope,
        data.createdByCourseScope,
        data.course
      );
    }

    function paymentTargetCourses(data) {
      return data.targetCourses is list ? data.targetCourses : [];
    }

    function paymentTargetCourseAtMatchesScope(targetCourses, courseScope, index) {
      return targetCourses.size() <= index ||
        normalizeCourseScopeValue(targetCourses[index]) == courseScope;
    }

    function paymentTargetCoursesContainScope(data, courseScope) {
      let targetCourses = paymentTargetCourses(data);

      return courseScope != "" &&
        (
          (targetCourses.size() > 0 &&
            normalizeCourseScopeValue(targetCourses[0]) == courseScope) ||
          (targetCourses.size() > 1 &&
            normalizeCourseScopeValue(targetCourses[1]) == courseScope) ||
          (targetCourses.size() > 2 &&
            normalizeCourseScopeValue(targetCourses[2]) == courseScope) ||
          (targetCourses.size() > 3 &&
            normalizeCourseScopeValue(targetCourses[3]) == courseScope) ||
          (targetCourses.size() > 4 &&
            normalizeCourseScopeValue(targetCourses[4]) == courseScope)
        );
    }

    function paymentTargetCoursesStayInScope(data, courseScope) {
      let targetCourses = paymentTargetCourses(data);
      return targetCourses.size() == 0 ||
        (
          courseScope != "" &&
          targetCourses.size() <= 5 &&
          paymentTargetCourseAtMatchesScope(targetCourses, courseScope, 0) &&
          paymentTargetCourseAtMatchesScope(targetCourses, courseScope, 1) &&
          paymentTargetCourseAtMatchesScope(targetCourses, courseScope, 2) &&
          paymentTargetCourseAtMatchesScope(targetCourses, courseScope, 3) &&
          paymentTargetCourseAtMatchesScope(targetCourses, courseScope, 4)
        );
    }

    function paymentDirectCourseMatchesScope(data, courseScope) {
      return normalizeCourseScopeValue(data.course) == courseScope;
    }

    function paymentCreatorCourseMatchesScope(data, courseScope) {
      return normalizeCourseScopeValue(data.createdByCourseScope) == courseScope;
    }

    function paymentOwnerCourseMatchesScope(data, courseScope) {
      return normalizeCourseScopeValue(data.courseScope) == courseScope;
    }

    function bodPaymentCreateIsScoped(data, courseScope) {
      return courseScope != "" &&
        paymentOwnerType(data) == "bod" &&
        paymentOwnerCourseMatchesScope(data, courseScope) &&
        data.createdByUid == request.auth.uid &&
        paymentCreatorCourseMatchesScope(data, courseScope) &&
        paymentDirectCourseMatchesScope(data, courseScope) &&
        paymentTargetCoursesStayInScope(data, courseScope);
    }

    function bodManageablePaymentData(data, courseScope) {
      return courseScope != "" &&
        paymentOwnerType(data) == "bod" &&
        paymentCourseScope(data) == courseScope &&
        data.createdByUid == request.auth.uid &&
        paymentCreatorCourseMatchesScope(data, courseScope) &&
        paymentDirectCourseMatchesScope(data, courseScope) &&
        paymentTargetCoursesStayInScope(data, courseScope);
    }

    function canViewEcPaymentDataForBod(data, courseScope) {
      return courseScope != "" &&
        paymentOwnerType(data) == "ec" &&
        (
          paymentOwnerCourseMatchesScope(data, courseScope) ||
          paymentCreatorCourseMatchesScope(data, courseScope) ||
          paymentDirectCourseMatchesScope(data, courseScope) ||
          paymentTargetCoursesContainScope(data, courseScope)
        );
    }

    function canViewPaymentData(data) {
      let currentData = currentProfileData();
      let currentRoleValue = profileRole(currentData);
      let courseScope = currentCourseScopeFromData(currentData, currentRoleValue);

      return currentRoleValue == "admin" ||
        isRegularECProfileDataWithRole(currentData, currentRoleValue) ||
        (
          bodManageablePaymentData(data, courseScope) ||
          canViewEcPaymentDataForBod(data, courseScope)
        );
    }

    function canCreatePaymentData(data) {
      let currentData = currentProfileData();
      let currentRoleValue = profileRole(currentData);
      let courseScope = currentCourseScopeFromData(currentData, currentRoleValue);

      return currentRoleValue == "admin" ||
        isRegularECProfileDataWithRole(currentData, currentRoleValue) ||
        bodPaymentCreateIsScoped(data, courseScope);
    }

    function canUpdatePaymentData(oldData, newData) {
      let currentData = currentProfileData();
      let currentRoleValue = profileRole(currentData);
      let courseScope = currentCourseScopeFromData(currentData, currentRoleValue);

      return currentRoleValue == "admin" ||
        isRegularECProfileDataWithRole(currentData, currentRoleValue) ||
        (
          bodManageablePaymentData(oldData, courseScope) &&
          bodPaymentCreateIsScoped(newData, courseScope)
        );
    }

    function canDeletePaymentData(data) {
      let currentData = currentProfileData();
      let currentRoleValue = profileRole(currentData);
      let courseScope = currentCourseScopeFromData(currentData, currentRoleValue);

      return currentRoleValue == "admin" ||
        isRegularECProfileDataWithRole(currentData, currentRoleValue) ||
        bodManageablePaymentData(data, courseScope);
    }

    function selfPaymentAssignmentPath(paymentId) {
      return /databases/$(database)/documents/payments/$(paymentId)/students/$(request.auth.uid);
    }

    function hasSelfPaymentAssignment(paymentId) {
      return signedIn() && exists(selfPaymentAssignmentPath(paymentId));
    }

    function targetProfileCourseMatchesScope(uid) {
      let courseScope = currentCourseScope();
      return courseScope != "" &&
        userProfileExists(uid) &&
        studentProfileHasIdentityAndMatchesScope(
          userProfileDoc(uid),
          courseScope
        );
    }

    function paymentStudentTargetProfileMatchesScope(uid, courseScope) {
      return courseScope != "" &&
        userProfileExists(uid) &&
        studentProfileHasIdentityAndMatchesScope(
          userProfileDoc(uid),
          courseScope
        );
    }

    function paymentStudentMatchesCurrentScope(uid, data, courseScope) {
      return dataCourseMatchesScope(data, courseScope) ||
        paymentStudentTargetProfileMatchesScope(uid, courseScope);
    }

    function canReadPaymentStudentDataForBod(paymentData, studentUid, studentData) {
      let currentData = currentProfileData();
      let currentRoleValue = profileRole(currentData);
      let courseScope = currentCourseScopeFromData(currentData, currentRoleValue);

      return courseScope != "" &&
        (
          bodManageablePaymentData(paymentData, courseScope) ||
          canViewEcPaymentDataForBod(paymentData, courseScope)
        ) &&
        paymentStudentMatchesCurrentScope(studentUid, studentData, courseScope);
    }

    function canWritePaymentStudentDataForBod(paymentData, currentExists, currentData, nextData, courseScope) {
      return courseScope != "" &&
        nextData != null &&
        dataCourseMatchesScope(nextData, courseScope) &&
        (
          !currentExists ||
          dataCourseMatchesScope(currentData, courseScope)
        ) &&
        bodManageablePaymentData(paymentData, courseScope);
    }

    function canWritePaymentStudentData(paymentId, currentExists, currentData, nextData) {
      let currentProfile = currentProfileData();
      let currentRoleValue = profileRole(currentProfile);
      let courseScope = currentCourseScopeFromData(currentProfile, currentRoleValue);

      return currentRoleValue == "admin" ||
        isRegularECProfileDataWithRole(currentProfile, currentRoleValue) ||
        (
          paymentExists(paymentId) &&
          canWritePaymentStudentDataForBod(
            paymentDoc(paymentId),
            currentExists,
            currentData,
            nextData,
            courseScope
          )
        );
    }

    function canDeletePaymentStudentDataForBod(paymentData, studentData, courseScope) {
      return dataCourseMatchesScope(studentData, courseScope) &&
        bodManageablePaymentData(paymentData, courseScope);
    }

    function canDeletePaymentStudentData(paymentId, data) {
      let currentProfile = currentProfileData();
      let currentRoleValue = profileRole(currentProfile);
      let courseScope = currentCourseScopeFromData(currentProfile, currentRoleValue);

      return currentRoleValue == "admin" ||
        isRegularECProfileDataWithRole(currentProfile, currentRoleValue) ||
        (
          paymentExists(paymentId) &&
          canDeletePaymentStudentDataForBod(paymentDoc(paymentId), data, courseScope)
        );
    }

    function canReadOwnPaymentStudentAssignment(studentUid, studentData) {
      return signedIn() &&
        currentHasStudentIdentity() &&
        (
          isSelf(studentUid) ||
          studentData.uid == request.auth.uid
        );
    }

    function ecDocumentOwnerType(data) {
      return data.ownerType == "bod" ? "bod" : "ec";
    }

    function ecDocumentCourseScope(data) {
      return firstCourseScopeValue(
        data.courseScope,
        data.createdByCourseScope,
        data.course
      );
    }

    function ecDocumentStrictCourseScope(data) {
      return ecDocumentCourseScope(data);
    }

    function ecDocumentCourseScopeSlugMatchesScope(data) {
      return !(data.courseScopeSlug is string) ||
        data.courseScopeSlug == "" ||
        data.courseScopeSlug == currentCourseScopeSlug();
    }

    function ecDocumentStoragePathIsScoped(data) {
      return data.storagePath is string &&
        currentCourseScopeSlug() != "" &&
        (
          data.storagePath.matches("^documents/course/" + currentCourseScopeSlug() + "/[^/]+/.+$") ||
          data.storagePath.matches("^ec-documents/course/" + currentCourseScopeSlug() + "/[^/]+/.+$")
        );
    }

    function ecDocumentCreatedByUid(data) {
      return data.createdBy != null && data.createdBy != "" ? data.createdBy :
        (
          data.createdByUid != null &&
          data.createdByUid != ""
        ) ? data.createdByUid :
        (
          data.uploadedByUid != null &&
          data.uploadedByUid != ""
        ) ? data.uploadedByUid :
        (
          data.ownerUid != null &&
          data.ownerUid != ""
        ) ? data.ownerUid :
        "";
    }

    function canManageOwnBodEcDocumentData(data) {
      return isBOD() &&
        hasCurrentCourseScope() &&
        ecDocumentOwnerType(data) == "bod" &&
        ecDocumentCreatedByUid(data) == request.auth.uid &&
        ecDocumentStrictCourseScope(data) == currentCourseScope() &&
        ecDocumentCourseScopeSlugMatchesScope(data) &&
        ecDocumentStoragePathIsScoped(data);
    }

    function canViewEcDocumentData(data) {
      return isAdminOrRegularEC() || canManageOwnBodEcDocumentData(data);
    }

    function enrollmentSessionCourseScope(data) {
      return firstCourseScopeValue(
        data.courseScope,
        data.createdByCourseScope,
        null
      );
    }

    function canViewEnrollmentSessionData(data) {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          hasCurrentCourseScope() &&
          enrollmentSessionCourseScope(data) == currentCourseScope()
        );
    }

    match /profiles/{uid} {
      allow read: if isSelf(uid) || canReadStudentProfileData(resource.data);
      allow create: if currentIsAdmin();
      allow update: if currentIsAdmin() ||
        canManageStudentProfileUpdateData(resource.data, request.resource.data) ||
        (
          isSelf(uid) &&
          selfProfileUpdateKeepsAccessAssignments(resource.data, request.resource.data)
        );
      allow delete: if currentIsAdmin();

      match /documents/{docId} {
        allow read: if isSelf(uid) || currentIsAdmin();
        allow create, update, delete: if (isSelf(uid) && isEC()) || currentIsAdmin();
      }

      match /notifications/{notificationId} {
        allow read: if (isSelf(uid) && currentHasStudentIdentity()) || currentIsAdminOrRegularEC() ||
          canReadBodNotification(uid);
        allow create: if currentIsAdminOrRegularEC() ||
          canCreateBodNotification(uid, request.resource.data);
        allow update: if currentIsAdminOrRegularEC() ||
          canUpdateBodNotification(uid, resource.data, request.resource.data);
        allow delete: if currentIsAdminOrRegularEC() ||
          canDeleteBodNotification(uid, resource.data);
      }
    }

    match /logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if signedIn() && canViewEventData(resource.data);
      allow create: if signedIn() && canCreateEventData(request.resource.data);
      allow update: if signedIn() && canUpdateEventData();
      allow delete: if signedIn() && canDeleteEventData();

      match /images/{imageId} {
        allow read: if canReadEventSubcollection(eventId);
        allow create, update, delete: if signedIn() &&
          canManageEventSubcollection(eventId);
      }

      match /docs/{docId} {
        allow read: if canReadEventDocumentSubcollection(eventId);
        allow create, update: if signedIn() &&
          canManageEventSubcollection(eventId) &&
          eventDocumentMetadataIsValid(eventId, request.resource.data);
        allow delete: if signedIn() &&
          canManageEventSubcollection(eventId);
      }

      match /attendance/{uid} {
        allow read: if currentIsAdminOrRegularEC() || currentIsTeacher() ||
          (isSelf(uid) && currentHasStudentIdentity()) ||
          canReadScopedEventParticipant(eventId, uid, resource.data);
        allow create, update, delete: if currentIsAdminOrRegularEC() ||
          canWriteScopedEventParticipant(
            eventId,
            exists(/databases/$(database)/documents/events/$(eventId)/attendance/$(uid)),
            resource.data,
            request.resource.data
          );
      }

      match /registrations/{uid} {
        allow read: if currentIsAdminOrRegularEC() ||
          (isSelf(uid) && currentHasStudentIdentity()) ||
          canReadScopedEventParticipant(eventId, uid, resource.data);
        allow create, update, delete: if currentIsAdminOrRegularEC() ||
          canWriteScopedEventParticipant(
            eventId,
            exists(/databases/$(database)/documents/events/$(eventId)/registrations/$(uid)),
            resource.data,
            request.resource.data
          );
      }

      match /{subcollection}/{docId} {
        allow read, create, update, delete: if currentIsAdminOrRegularEC();
      }
    }

    match /payments/{paymentId} {
      allow read: if signedIn() &&
        (
          canViewPaymentData(resource.data) ||
          hasSelfPaymentAssignment(paymentId)
        );
      allow create: if signedIn() && canCreatePaymentData(request.resource.data);
      allow update: if signedIn() &&
        canUpdatePaymentData(resource.data, request.resource.data);
      allow delete: if signedIn() && canDeletePaymentData(resource.data);

      match /students/{studentUid} {
        allow read: if currentIsAdminOrRegularEC() ||
          canReadOwnPaymentStudentAssignment(studentUid, resource.data) ||
          (
            paymentExists(paymentId) &&
            canReadPaymentStudentDataForBod(
              paymentDoc(paymentId),
              studentUid,
              resource.data
            )
          );
        allow create: if canWritePaymentStudentData(
          paymentId,
          false,
          null,
          request.resource.data
        );
        allow update: if canWritePaymentStudentData(
          paymentId,
          true,
          resource.data,
          request.resource.data
        );
        allow delete: if canDeletePaymentStudentData(paymentId, resource.data);
      }
    }

    match /ecDocuments/{docId} {
      allow read: if signedIn() && canViewEcDocumentData(resource.data);
      allow create: if isAdminOrRegularEC() ||
        canManageOwnBodEcDocumentData(request.resource.data);
      allow update: if isAdminOrRegularEC() ||
        (
          canManageOwnBodEcDocumentData(resource.data) &&
          canManageOwnBodEcDocumentData(request.resource.data)
        );
      allow delete: if isAdminOrRegularEC() ||
        canManageOwnBodEcDocumentData(resource.data);
    }

    match /students/{studentId} {
      allow read: if currentIsTeacher() ||
        (isSelf(studentId) && currentHasStudentIdentity()) ||
        canManageStudentData(resource.data);
      allow create: if canManageStudentData(request.resource.data);
      allow update: if canManageStudentData(resource.data) &&
        canManageStudentData(request.resource.data);
      allow delete: if canManageStudentData(resource.data);
    }

    match /devices/{deviceId} {
      allow read, write: if isAdmin();

      match /syncLogs/{logId} {
        allow read: if isAdminOrEC();
        allow write: if false;
      }
    }

    match /devicePairings/{deviceId} {
      allow read: if isAdminOrEC();
      allow create, update, delete: if isAdminOrEC();
    }

    match /enrollmentSessions/{sessionId} {
      allow read: if canViewEnrollmentSessionData(resource.data);
      allow create, update, delete: if isAdminOrRegularEC();

      match /students/{studentId} {
        allow read: if canViewEnrollmentSessionData(
          get(/databases/$(database)/documents/enrollmentSessions/$(sessionId)).data
        );
        allow create, update, delete: if isAdminOrRegularEC();
      }
    }

    match /enrollmentQueue/{queueId} {
      allow read, create, update, delete: if isAdminOrRegularEC();
    }

    match /fingerprintTemplates/{templateId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /moduleCleanupQueue/{cleanupId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /syncLogs/{logId} {
      allow read: if isAdminOrEC();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
