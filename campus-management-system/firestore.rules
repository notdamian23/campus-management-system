rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/profiles/$(request.auth.uid);
    }

    function role() {
      return signedIn() && exists(profilePath())
        ? get(profilePath()).data.role
        : "";
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && role() == "admin";
    }

    function isTeacher() {
      return signedIn() && role() == "teacher";
    }

    function isEC() {
      return signedIn() && role() == "ec";
    }

    function isAdminOrEC() {
      return isAdmin() || isEC();
    }

    function canManageStudentStatusOnProfile() {
      return isAdminOrEC() &&
        resource.data.role == "student" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]) &&
        request.resource.data.status in ["Active", "Inactive"];
    }

    function activeStudentAccount() {
      return signedIn() &&
        role() == "student" &&
        get(profilePath()).data.status != "Inactive";
    }

    // Profiles
    match /profiles/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isAdmin();
      allow update: if isSelf(uid) || isAdmin() || canManageStudentStatusOnProfile();
      allow delete: if isAdmin();

      // EC member personal documents
      match /documents/{docId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update, delete: if (isSelf(uid) && isEC()) || isAdmin();
      }

      // Student notifications written by EC/Admin
      match /notifications/{notificationId} {
        allow read: if isSelf(uid) || isAdminOrEC();
        allow create, update, delete: if isAdminOrEC();
      }
    }

    // Admin logs (written by Admin SDK / Cloud Functions)
    match /logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Events
    match /events/{eventId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdminOrEC();

      match /registrations/{uid} {
        allow read: if isAdminOrEC() ||
          isSelf(uid) ||
          (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if isSelf(uid) &&
          request.resource.data.uid == request.auth.uid &&
          activeStudentAccount();
        allow update: if isSelf(uid) &&
          request.resource.data.uid == request.auth.uid &&
          activeStudentAccount();
        allow delete: if isAdminOrEC() || isSelf(uid);
      }

      match /{subcollection}/{docId} {
        allow read: if signedIn();
        allow create, update, delete: if isAdminOrEC();
      }
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdminOrEC();

      match /students/{studentUid} {
        allow read: if isAdminOrEC() ||
          isSelf(studentUid) ||
          (signedIn() && resource.data.uid == request.auth.uid);
        allow create, update, delete: if isAdminOrEC();
      }
    }

    // Shared EC document library (1 GB shared pool handled by app logic)
    match /ecDocuments/{docId} {
      allow read: if isAdminOrEC();
      allow create, update, delete: if isAdminOrEC();
    }

    // Student directory projection for portable device enrollment + sync.
    match /students/{studentId} {
      allow read: if isAdminOrEC() || isTeacher() || isSelf(studentId);
      allow create, update, delete: if isAdminOrEC();
    }

    // Physical device secrets and session state.
    match /devices/{deviceId} {
      allow read, write: if isAdmin();

      match /syncLogs/{logId} {
        allow read: if isAdminOrEC();
        allow write: if false;
      }
    }

    // Device pairing state that can be shown on EC dashboards.
    match /devicePairings/{deviceId} {
      allow read: if isAdminOrEC();
      allow create, update, delete: if isAdminOrEC();
    }

    // Fingerprint enrollment sessions prepared by EC/Admin for the CAMPUS module.
    match /enrollmentSessions/{sessionId} {
      allow read, create, update, delete: if isAdminOrEC();

      match /students/{studentId} {
        allow read, create, update, delete: if isAdminOrEC();
      }
    }

    // Enrollment tasks prepared on the website, consumed by the device through Cloud Functions.
    match /enrollmentQueue/{queueId} {
      allow read: if isAdminOrEC();
      allow create, update, delete: if isAdminOrEC();
    }

    // Sync logs are written by Admin SDK functions for auditability.
    match /syncLogs/{logId} {
      allow read: if isAdminOrEC();
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
