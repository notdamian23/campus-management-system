rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/profiles/$(request.auth.uid);
    }

    function userProfilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }

    function userProfileExists(uid) {
      return exists(userProfilePath(uid));
    }

    function userProfileDoc(uid) {
      return get(userProfilePath(uid)).data;
    }

    function eventPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId);
    }

    function paymentPath(paymentId) {
      return /databases/$(database)/documents/payments/$(paymentId);
    }

    function paymentExists(paymentId) {
      return exists(paymentPath(paymentId));
    }

    function paymentDoc(paymentId) {
      return get(paymentPath(paymentId)).data;
    }

    function hasProfile() {
      return signedIn() && userProfileExists(request.auth.uid);
    }

    function profile() {
      return hasProfile() ? userProfileDoc(request.auth.uid) : null;
    }

    function profileRole(data) {
      return data != null && data.role is string ? data.role : "";
    }

    function role() {
      return profileRole(profile());
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && role() == "admin";
    }

    function isTeacher() {
      return signedIn() && role() == "teacher";
    }

    function isRegularECMemberRole(value) {
      return value == "ec" || value == "ecmember";
    }

    function isBodRole(value) {
      return value == "bod";
    }

    function isECMemberRole(value) {
      return isRegularECMemberRole(value) || isBodRole(value);
    }

    function isStudentOnlyRole(value) {
      return value == "student";
    }

    function hasStudentIdentityFields(data) {
      return data != null &&
        (
          (data.schoolId is string && data.schoolId != "") ||
          (data.schoolIdKey is string && data.schoolIdKey != "") ||
          (data.studentId is string && data.studentId != "")
        );
    }

    function hasStudentSelfIdentity() {
      return hasProfile() && studentProfileHasIdentity(profile());
    }

    function studentProfileHasIdentity(data) {
      return data != null &&
        (
          data.role == "student" ||
          data.isStudent == true ||
          isECMemberRole(data.role)
        ) &&
        hasStudentIdentityFields(data);
    }

    function normalizeCourseScopeValue(value) {
      return value == "ME" ||
        value == "BSME" ||
        value == "Mechanical Engineering" ||
        value == "mechanical-engineering" ? "Mechanical Engineering" :
        value == "EE" ||
        value == "BSEE" ||
        value == "Electrical Engineering" ||
        value == "electrical-engineering" ? "Electrical Engineering" :
        value == "IE" ||
        value == "BSIE" ||
        value == "Industrial Engineering" ||
        value == "industrial-engineering" ? "Industrial Engineering" :
        value == "CPE" ||
        value == "BSCpE" ||
        value == "BSCPE" ||
        value == "Computer Engineering" ||
        value == "computer-engineering" ? "Computer Engineering" :
        value == "ECE" ||
        value == "BSECE" ||
        value == "Electronics Engineering" ||
        value == "electronics-engineering" ? "Electronics Engineering" :
        "";
    }

    function firstCourseScopeValue(primary, secondary, tertiary) {
      let primaryScope = normalizeCourseScopeValue(primary);
      let secondaryScope = normalizeCourseScopeValue(secondary);
      let tertiaryScope = normalizeCourseScopeValue(tertiary);

      return primaryScope != "" ? primaryScope :
        secondaryScope != "" ? secondaryScope :
        tertiaryScope;
    }

    function isEC() {
      return signedIn() && isECMemberRole(role());
    }

    function inferCourseScopeFromPosition(position) {
      return position == "B.O.D. (ME)" ? "Mechanical Engineering" :
        position == "B.O.D. (EE)" ? "Electrical Engineering" :
        position == "B.O.D. (IE)" ? "Industrial Engineering" :
        position == "B.O.D. (CPE)" ? "Computer Engineering" :
        position == "B.O.D. (ECE)" ? "Electronics Engineering" :
        "";
    }

    function courseScopeFromAssignedCourse(courseCode) {
      return normalizeCourseScopeValue(courseCode);
    }

    function courseScopeFromProfileData(data) {
      let labelScope = normalizeCourseScopeValue(data.courseScopeLabel);
      let courseScope = normalizeCourseScopeValue(data.course);
      let assignedScope = courseScopeFromAssignedCourse(data.assignedCourse);
      let positionScope = inferCourseScopeFromPosition(data.ecPosition);
      let slugScope = normalizeCourseScopeValue(data.courseScope);

      return labelScope != "" ? labelScope :
        courseScope != "" ? courseScope :
        assignedScope != "" ? assignedScope :
        positionScope != "" ? positionScope :
        slugScope;
    }

    function courseScopeSlug(courseScope) {
      return courseScope == "Mechanical Engineering" ? "mechanical-engineering" :
        courseScope == "Electrical Engineering" ? "electrical-engineering" :
        courseScope == "Industrial Engineering" ? "industrial-engineering" :
        courseScope == "Computer Engineering" ? "computer-engineering" :
        courseScope == "Electronics Engineering" ? "electronics-engineering" :
        "";
    }

    function isAllScopeECPosition(position) {
      return position == "President" ||
        position == "Vice President" ||
        position == "Secretary" ||
        position == "Treasurer" ||
        position == "Auditor" ||
        position == "P.I.O." ||
        position == "H.A.S.";
    }

    function isBODPosition(position) {
      return position == "B.O.D." ||
        position == "B.O.D. (ME)" ||
        position == "B.O.D. (EE)" ||
        position == "B.O.D. (IE)" ||
        position == "B.O.D. (CPE)" ||
        position == "B.O.D. (ECE)";
    }

    function hasBodCourseMarkers(data) {
      return data != null && courseScopeFromProfileData(data) != "";
    }

    function currentCourseScope() {
      let data = profile();
      return data != null && isBODProfileData(data) ?
        courseScopeFromProfileData(data) :
        "";
    }

    function hasCurrentCourseScope() {
      return currentCourseScope() != "";
    }

    function currentCourseScopeSlug() {
      let courseScope = currentCourseScope();
      return courseScope != "" ? courseScopeSlug(courseScope) : "";
    }

    function courseMatchesCurrentScope(value) {
      let courseScope = currentCourseScope();
      return courseScope != "" && normalizeCourseScopeValue(value) == courseScope;
    }

    function studentRecordMatchesCurrentScope(data) {
      return data != null && courseMatchesCurrentScope(data.course);
    }

    function bodManageableStudentData(data) {
      return data != null &&
        (
          !("role" in data) ||
          isStudentOnlyRole(data.role)
        ) &&
        studentRecordMatchesCurrentScope(data);
    }

    function studentOnlyProfileMatchesCurrentScope(data) {
      return data != null &&
        isStudentOnlyRole(profileRole(data)) &&
        studentRecordMatchesCurrentScope(data);
    }

    function studentProfileHasIdentityAndMatchesCurrentScope(data) {
      return studentProfileHasIdentity(data) &&
        studentRecordMatchesCurrentScope(data);
    }

    function isBODProfileData(data) {
      return data != null &&
        (
          profileRole(data) == "bod" ||
          (
            isECMemberRole(profileRole(data)) &&
            (
              data.ecScope == "course" ||
              (
                data.ecScope != "all" &&
                (
                  data.isBod == true ||
                  isBODPosition(data.ecPosition) ||
                  (
                    !isAllScopeECPosition(data.ecPosition) &&
                    hasBodCourseMarkers(data)
                  )
                )
              )
            )
          )
        );
    }

    function isRegularECProfileData(data) {
      return data != null &&
        isRegularECMemberRole(profileRole(data)) &&
        (data.ecScope == "all" || !isBODProfileData(data));
    }

    function isBOD() {
      return isBODProfileData(profile());
    }

    function isRegularEC() {
      return isRegularECProfileData(profile());
    }

    function isAdminOrEC() {
      return isAdmin() || isEC();
    }

    function isAdminOrRegularEC() {
      return isAdmin() || isRegularEC();
    }

    function canManageStudentData(data) {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          hasCurrentCourseScope() &&
          bodManageableStudentData(data)
        );
    }

    function canManageStudentProfileUpdateData(oldData, newData) {
      return oldData != null &&
        newData != null &&
        profileRole(oldData) == "student" &&
        profileRole(newData) == profileRole(oldData) &&
        (
          isAdminOrRegularEC() ||
          (
            isBOD() &&
            hasCurrentCourseScope() &&
            studentRecordMatchesCurrentScope(oldData) &&
            studentRecordMatchesCurrentScope(newData)
          )
        ) &&
        newData.diff(oldData).affectedKeys().hasOnly([
          "schoolId",
          "schoolIdKey",
          "name",
          "fullName",
          "studentName",
          "course",
          "year",
          "yearLevel",
          "status",
          "readyForClearance",
          "updatedAt",
        ]);
    }

    function canReadStudentProfileData(data) {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          hasCurrentCourseScope() &&
          studentOnlyProfileMatchesCurrentScope(data)
        );
    }

    function notificationCourseScope(data) {
      let directCourseScope = normalizeCourseScopeValue(data.course);
      let listCourseScope = data.courses is list && data.courses.size() == 1 ?
        normalizeCourseScopeValue(data.courses[0]) :
        "";

      return directCourseScope != "" ? directCourseScope : listCourseScope;
    }

    function notificationCoursesStayInScope(data) {
      let courses = data.courses is list ? data.courses : [];

      return courses.size() == 0 ||
        (
          courses.size() == 1 &&
          courseMatchesCurrentScope(courses[0])
        );
    }

    function bodNotificationTargetProfileMatchesScope(uid) {
      return userProfileExists(uid) &&
        studentOnlyProfileMatchesCurrentScope(userProfileDoc(uid));
    }

    function canReadBodNotification(uid) {
      return isBOD() &&
        hasCurrentCourseScope() &&
        bodNotificationTargetProfileMatchesScope(uid);
    }

    function canManageBodNotificationTarget(uid) {
      return isBOD() &&
        hasCurrentCourseScope() &&
        (
          isSelf(uid) ||
          bodNotificationTargetProfileMatchesScope(uid)
        );
    }

    function bodNotificationDataIsScoped(data) {
      return data != null &&
        data.createdByUid == request.auth.uid &&
        notificationCourseScope(data) == currentCourseScope() &&
        notificationCoursesStayInScope(data);
    }

    function canCreateBodNotification(uid, newData) {
      return canManageBodNotificationTarget(uid) &&
        bodNotificationDataIsScoped(newData);
    }

    function canUpdateBodNotification(uid, oldData, newData) {
      return canManageBodNotificationTarget(uid) &&
        oldData.createdByUid == request.auth.uid &&
        bodNotificationDataIsScoped(newData);
    }

    function canDeleteBodNotification(uid, oldData) {
      return canManageBodNotificationTarget(uid) &&
        oldData.createdByUid == request.auth.uid;
    }

    function selfProfileUpdateKeepsAccessAssignments(oldData, newData) {
      return oldData != null &&
        newData != null &&
        profileRole(newData) == profileRole(oldData) &&
        newData.ecPosition == oldData.ecPosition &&
        newData.ecScope == oldData.ecScope &&
        newData.assignedCourse == oldData.assignedCourse &&
        newData.courseScope == oldData.courseScope &&
        newData.courseScopeLabel == oldData.courseScopeLabel &&
        newData.isBod == oldData.isBod &&
        newData.isStudent == oldData.isStudent;
    }

    function eventOwnerType(data) {
      return data.ownerType == "bod" ? "bod" : "ec";
    }

    function eventCourseScope(data) {
      return firstCourseScopeValue(
        data.courseScope,
        data.createdByCourseScope,
        data.course
      );
    }

    function eventSelectedStudentIds(data) {
      return data.selectedStudentIds is list ? data.selectedStudentIds : [];
    }

    function eventSelectedSchoolIds(data) {
      return data.selectedSchoolIds is list ? data.selectedSchoolIds : [];
    }

    function bodCreateBaseIsScoped(data) {
      let courseScope = currentCourseScope();
      let course = normalizeCourseScopeValue(data.course);
      let ownerCourseScope = normalizeCourseScopeValue(data.courseScope);
      let creatorCourseScope = normalizeCourseScopeValue(data.createdByCourseScope);

      return isBOD() &&
        courseScope != "" &&
        data.ownerType == "bod" &&
        data.createdBy == request.auth.uid &&
        course == courseScope &&
        ownerCourseScope == courseScope &&
        creatorCourseScope == courseScope &&
        data.courses is list &&
        data.courses.size() == 1 &&
        data.courses[0] == courseScope;
    }

    function bodNoSelectedAudienceCreateIsScoped(data) {
      return (
        !("selectedStudentIds" in data) ||
        (data.selectedStudentIds is list && data.selectedStudentIds.size() == 0)
      ) &&
        (
          !("selectedSchoolIds" in data) ||
          (data.selectedSchoolIds is list && data.selectedSchoolIds.size() == 0)
        ) &&
        (
          !("targetStudent" in data) ||
          data.targetStudent == ""
        );
    }

    function bodSelectedStudentProfileMatchesScope(data, expectedSchoolId) {
      return studentOnlyProfileMatchesCurrentScope(data) &&
        (
          expectedSchoolId == "" ||
          data.schoolId == expectedSchoolId
        );
    }

    function bodSelectedStudentAtMatchesScope(studentIds, schoolIds, index) {
      return studentIds.size() <= index ||
        (
          exists(userProfilePath(studentIds[index])) &&
          bodSelectedStudentProfileMatchesScope(
            get(userProfilePath(studentIds[index])).data,
            schoolIds.size() > index ? schoolIds[index] : ""
          )
        );
    }

    function bodSelectedAudienceIdsAreScoped(studentIds, schoolIds) {
      return bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 0) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 1) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 2) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 3) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 4) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 5) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 6) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 7) &&
        bodSelectedStudentAtMatchesScope(studentIds, schoolIds, 8);
    }

    function bodSelectedAudienceCreateIsScoped(data) {
      let studentIds = eventSelectedStudentIds(data);
      let schoolIds = eventSelectedSchoolIds(data);

      return "selectedStudentIds" in data &&
        data.selectedStudentIds is list &&
        studentIds.size() >= 1 &&
        studentIds.size() <= 9 &&
        (schoolIds.size() == 0 || schoolIds.size() == studentIds.size()) &&
        bodSelectedAudienceIdsAreScoped(studentIds, schoolIds) &&
        (
          !("targetStudent" in data) ||
          data.targetStudent == "" ||
          data.targetStudent.matches("^Specific students selected \\([1-9][0-9]*\\)$")
        );
    }

    function bodEventAudienceIsScoped(data) {
      return bodCreateBaseIsScoped(data) &&
        (
          bodNoSelectedAudienceCreateIsScoped(data) ||
          bodSelectedAudienceCreateIsScoped(data)
        );
    }

    function canViewEventData(data) {
      return !isEC() ? signedIn() :
        isAdminOrRegularEC() ||
        (
          isBOD() &&
          (
            eventOwnerType(data) == "ec" ||
            (
              hasCurrentCourseScope() &&
              eventCourseScope(data) == currentCourseScope()
            )
          )
        );
    }

    function canCreateEventData(data) {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          hasCurrentCourseScope() &&
          bodEventAudienceIsScoped(data)
        );
    }

    function canUpdateEventData() {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          hasCurrentCourseScope() &&
          eventOwnerType(resource.data) == "bod" &&
          eventCourseScope(resource.data) == currentCourseScope() &&
          resource.data.createdBy == request.auth.uid &&
          bodEventAudienceIsScoped(request.resource.data)
        );
    }

    function canDeleteEventData() {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          hasCurrentCourseScope() &&
          eventOwnerType(resource.data) == "bod" &&
          eventCourseScope(resource.data) == currentCourseScope() &&
          resource.data.createdBy == request.auth.uid
        );
    }

    function eventDoc(eventId) {
      return get(eventPath(eventId)).data;
    }

    function eventExists(eventId) {
      return exists(eventPath(eventId));
    }

    function canManageOwnBodEventSubcollectionData(data) {
      return isBOD() &&
        hasCurrentCourseScope() &&
        eventOwnerType(data) == "bod" &&
        eventCourseScope(data) == currentCourseScope() &&
        data.createdBy == request.auth.uid;
    }

    function canReadEventSubcollection(eventId) {
      return signedIn() &&
        eventExists(eventId) &&
        canViewEventData(eventDoc(eventId));
    }

    function canManageEventSubcollection(eventId) {
      return isAdminOrRegularEC() ||
        (
          eventExists(eventId) &&
          canManageOwnBodEventSubcollectionData(eventDoc(eventId))
        );
    }

    function eventParticipantMatchesCurrentScope(uid, data) {
      return courseMatchesCurrentScope(data.course) ||
        targetProfileCourseMatchesScope(uid);
    }

    function canReadScopedEventParticipant(eventId, uid, data) {
      return isBOD() &&
        hasCurrentCourseScope() &&
        eventParticipantMatchesCurrentScope(uid, data) &&
        canReadEventSubcollection(eventId);
    }

    function canWriteScopedEventParticipant(eventId, currentExists, currentData, nextData) {
      return isBOD() &&
        hasCurrentCourseScope() &&
        nextData != null &&
        courseMatchesCurrentScope(nextData.course) &&
        (
          !currentExists ||
          courseMatchesCurrentScope(currentData.course)
        ) &&
        canManageEventSubcollection(eventId);
    }

    function paymentOwnerType(data) {
      return data.ownerType == "bod" ? "bod" : "ec";
    }

    function paymentCourseScope(data) {
      return firstCourseScopeValue(
        data.courseScope,
        data.createdByCourseScope,
        data.course
      );
    }

    function paymentTargetCourses(data) {
      return data.targetCourses is list ? data.targetCourses : [];
    }

    function paymentTargetCourseAtMatchesScope(targetCourses, courseScope, index) {
      return targetCourses.size() <= index ||
        normalizeCourseScopeValue(targetCourses[index]) == courseScope;
    }

    function paymentTargetCoursesContainScope(data, courseScope) {
      let targetCourses = paymentTargetCourses(data);

      return courseScope != "" &&
        (
          (targetCourses.size() > 0 &&
            normalizeCourseScopeValue(targetCourses[0]) == courseScope) ||
          (targetCourses.size() > 1 &&
            normalizeCourseScopeValue(targetCourses[1]) == courseScope) ||
          (targetCourses.size() > 2 &&
            normalizeCourseScopeValue(targetCourses[2]) == courseScope) ||
          (targetCourses.size() > 3 &&
            normalizeCourseScopeValue(targetCourses[3]) == courseScope) ||
          (targetCourses.size() > 4 &&
            normalizeCourseScopeValue(targetCourses[4]) == courseScope)
        );
    }

    function paymentTargetCoursesStayInScope(data, courseScope) {
      let targetCourses = paymentTargetCourses(data);
      return targetCourses.size() == 0 ||
        (
          courseScope != "" &&
          targetCourses.size() <= 5 &&
          paymentTargetCourseAtMatchesScope(targetCourses, courseScope, 0) &&
          paymentTargetCourseAtMatchesScope(targetCourses, courseScope, 1) &&
          paymentTargetCourseAtMatchesScope(targetCourses, courseScope, 2) &&
          paymentTargetCourseAtMatchesScope(targetCourses, courseScope, 3) &&
          paymentTargetCourseAtMatchesScope(targetCourses, courseScope, 4)
        );
    }

    function paymentDirectCourseMatchesScope(data, courseScope) {
      return normalizeCourseScopeValue(data.course) == courseScope;
    }

    function paymentCreatorCourseMatchesScope(data, courseScope) {
      return normalizeCourseScopeValue(data.createdByCourseScope) == courseScope;
    }

    function paymentOwnerCourseMatchesScope(data, courseScope) {
      return normalizeCourseScopeValue(data.courseScope) == courseScope;
    }

    function bodPaymentCreateIsScoped(data) {
      let courseScope = currentCourseScope();

      return isBOD() &&
        courseScope != "" &&
        paymentOwnerType(data) == "bod" &&
        paymentOwnerCourseMatchesScope(data, courseScope) &&
        data.createdByUid == request.auth.uid &&
        paymentCreatorCourseMatchesScope(data, courseScope) &&
        paymentDirectCourseMatchesScope(data, courseScope) &&
        paymentTargetCoursesStayInScope(data, courseScope);
    }

    function bodManageablePaymentData(data) {
      let courseScope = currentCourseScope();

      return isBOD() &&
        courseScope != "" &&
        paymentOwnerType(data) == "bod" &&
        paymentCourseScope(data) == courseScope &&
        data.createdByUid == request.auth.uid &&
        paymentCreatorCourseMatchesScope(data, courseScope) &&
        paymentDirectCourseMatchesScope(data, courseScope) &&
        paymentTargetCoursesStayInScope(data, courseScope);
    }

    function canViewEcPaymentDataForBod(data) {
      let courseScope = currentCourseScope();

      return isBOD() &&
        courseScope != "" &&
        paymentOwnerType(data) == "ec" &&
        (
          paymentOwnerCourseMatchesScope(data, courseScope) ||
          paymentCreatorCourseMatchesScope(data, courseScope) ||
          paymentDirectCourseMatchesScope(data, courseScope) ||
          paymentTargetCoursesContainScope(data, courseScope)
        );
    }

    function canViewPaymentData(data) {
      return isAdminOrRegularEC() ||
        (
          bodManageablePaymentData(data) ||
          canViewEcPaymentDataForBod(data)
        );
    }

    function canCreatePaymentData(data) {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          hasCurrentCourseScope() &&
          bodPaymentCreateIsScoped(data)
        );
    }

    function canUpdatePaymentData(oldData, newData) {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          hasCurrentCourseScope() &&
          bodManageablePaymentData(oldData) &&
          bodPaymentCreateIsScoped(newData)
        );
    }

    function canDeletePaymentData(data) {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          hasCurrentCourseScope() &&
          bodManageablePaymentData(data)
        );
    }

    function selfPaymentAssignmentPath(paymentId) {
      return /databases/$(database)/documents/payments/$(paymentId)/students/$(request.auth.uid);
    }

    function hasSelfPaymentAssignment(paymentId) {
      return signedIn() && exists(selfPaymentAssignmentPath(paymentId));
    }

    function targetProfileCourseMatchesScope(uid) {
      return userProfileExists(uid) &&
        studentProfileHasIdentityAndMatchesCurrentScope(
          userProfileDoc(uid)
        );
    }

    function paymentStudentMatchesCurrentScope(uid, data) {
      return studentRecordMatchesCurrentScope(data) ||
        targetProfileCourseMatchesScope(uid);
    }

    function canReadPaymentStudentDataForBod(paymentData, studentUid, studentData) {
      return isBOD() &&
        hasCurrentCourseScope() &&
        canViewPaymentData(paymentData) &&
        paymentStudentMatchesCurrentScope(studentUid, studentData);
    }

    function canWritePaymentStudentDataForBod(paymentData, currentExists, currentData, nextData) {
      return isBOD() &&
        hasCurrentCourseScope() &&
        nextData != null &&
        studentRecordMatchesCurrentScope(nextData) &&
        (
          !currentExists ||
          studentRecordMatchesCurrentScope(currentData)
        ) &&
        bodManageablePaymentData(paymentData);
    }

    function canWritePaymentStudentData(paymentId, currentExists, currentData, nextData) {
      return isAdminOrRegularEC() ||
        (
          paymentExists(paymentId) &&
          canWritePaymentStudentDataForBod(
            paymentDoc(paymentId),
            currentExists,
            currentData,
            nextData
          )
        );
    }

    function canDeletePaymentStudentDataForBod(paymentData, studentData) {
      return isBOD() &&
        hasCurrentCourseScope() &&
        studentRecordMatchesCurrentScope(studentData) &&
        bodManageablePaymentData(paymentData);
    }

    function canDeletePaymentStudentData(paymentId, data) {
      return isAdminOrRegularEC() ||
        (
          paymentExists(paymentId) &&
          canDeletePaymentStudentDataForBod(paymentDoc(paymentId), data)
        );
    }

    function ecDocumentOwnerType(data) {
      return data.ownerType == "bod" ? "bod" : "ec";
    }

    function ecDocumentCourseScope(data) {
      return firstCourseScopeValue(
        data.courseScope,
        data.createdByCourseScope,
        data.course
      );
    }

    function ecDocumentStrictCourseScope(data) {
      return ecDocumentCourseScope(data);
    }

    function ecDocumentCourseScopeSlugMatchesScope(data) {
      return !(data.courseScopeSlug is string) ||
        data.courseScopeSlug == "" ||
        data.courseScopeSlug == currentCourseScopeSlug();
    }

    function ecDocumentStoragePathIsScoped(data) {
      return data.storagePath is string &&
        currentCourseScopeSlug() != "" &&
        (
          data.storagePath.matches("^documents/course/" + currentCourseScopeSlug() + "/[^/]+/.+$") ||
          data.storagePath.matches("^ec-documents/course/" + currentCourseScopeSlug() + "/[^/]+/.+$")
        );
    }

    function ecDocumentCreatedByUid(data) {
      return data.createdBy != null && data.createdBy != "" ? data.createdBy :
        (
          data.createdByUid != null &&
          data.createdByUid != ""
        ) ? data.createdByUid :
        (
          data.uploadedByUid != null &&
          data.uploadedByUid != ""
        ) ? data.uploadedByUid :
        (
          data.ownerUid != null &&
          data.ownerUid != ""
        ) ? data.ownerUid :
        "";
    }

    function canManageOwnBodEcDocumentData(data) {
      return isBOD() &&
        hasCurrentCourseScope() &&
        ecDocumentOwnerType(data) == "bod" &&
        ecDocumentCreatedByUid(data) == request.auth.uid &&
        ecDocumentStrictCourseScope(data) == currentCourseScope() &&
        ecDocumentCourseScopeSlugMatchesScope(data) &&
        ecDocumentStoragePathIsScoped(data);
    }

    function canViewEcDocumentData(data) {
      return isAdminOrRegularEC() || canManageOwnBodEcDocumentData(data);
    }

    function enrollmentSessionCourseScope(data) {
      return firstCourseScopeValue(
        data.courseScope,
        data.createdByCourseScope,
        null
      );
    }

    function canViewEnrollmentSessionData(data) {
      return isAdminOrRegularEC() ||
        (
          isBOD() &&
          hasCurrentCourseScope() &&
          enrollmentSessionCourseScope(data) == currentCourseScope()
        );
    }

    match /students/{studentId} {
      allow read: if isTeacher() ||
        (isSelf(studentId) && hasStudentSelfIdentity()) ||
        canManageStudentData(resource.data);
      allow create: if canManageStudentData(request.resource.data);
      allow update: if canManageStudentData(resource.data) &&
        canManageStudentData(request.resource.data);
      allow delete: if canManageStudentData(resource.data);
    }

    match /payments/{paymentId} {
      allow read: if signedIn() &&
        (
          canViewPaymentData(resource.data) ||
          hasSelfPaymentAssignment(paymentId)
        );
      allow create: if signedIn() && canCreatePaymentData(request.resource.data);
      allow update: if signedIn() &&
        canUpdatePaymentData(resource.data, request.resource.data);
      allow delete: if signedIn() && canDeletePaymentData(resource.data);

      match /students/{studentUid} {
        allow read: if isAdminOrRegularEC() ||
          (isSelf(studentUid) && hasStudentSelfIdentity()) ||
          (
            signedIn() &&
            resource.data.uid == request.auth.uid &&
            hasStudentSelfIdentity()
          ) ||
          (
            paymentExists(paymentId) &&
            canReadPaymentStudentDataForBod(
              paymentDoc(paymentId),
              studentUid,
              resource.data
            )
          );
        allow create: if canWritePaymentStudentData(
          paymentId,
          false,
          null,
          request.resource.data
        );
        allow update: if canWritePaymentStudentData(
          paymentId,
          true,
          resource.data,
          request.resource.data
        );
        allow delete: if canDeletePaymentStudentData(paymentId, resource.data);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
