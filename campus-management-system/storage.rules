rules_version = "2";
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/(default)/documents/profiles/$(request.auth.uid);
    }

    function eventPath(eventId) {
      return /databases/(default)/documents/events/$(eventId);
    }

    function ecDocumentPath(docId) {
      return /databases/(default)/documents/ecDocuments/$(docId);
    }

    function hasProfile() {
      return signedIn() && firestore.exists(profilePath());
    }

    function profile() {
      return hasProfile() ? firestore.get(profilePath()).data : null;
    }

    function role() {
      return hasProfile() ? profile().role : "";
    }

    function isAdmin() {
      return signedIn() && role() == "admin";
    }

    function isRegularECMemberRole(value) {
      return value == "ec" || value == "ecmember";
    }

    function isBodRole(value) {
      return value == "bod";
    }

    function isECMemberRole(value) {
      return isRegularECMemberRole(value) || isBodRole(value);
    }

    function isEC() {
      return signedIn() && isECMemberRole(role());
    }

    // Accept both human-readable labels and historical slug/code variants.
    function normalizeCourseScopeValue(value) {
      return !(value is string) || value == "" ? null :
        value.matches("^([Mm]echanical([ -]?[Ee]ngineering)?|[Mm][.]?[Ee][.]?|[Bb][Ss][Mm][Ee])$") ? "Mechanical Engineering" :
        value.matches("^([Ee]lectrical([ -]?[Ee]ngineering)?|[Ee][.]?[Ee][.]?|[Bb][Ss][Ee][Ee])$") ? "Electrical Engineering" :
        value.matches("^([Ee]lectronics([ -]?[Ee]ngineering)?|[Ee]lectronics[ -]?[Aa]nd[ -]?[Cc]ommunications([ -]?[Ee]ngineering)?|[Ee][.]?[Cc][.]?[Ee][.]?|[Bb][Ss][Ee][Cc][Ee])$") ? "Electronics Engineering" :
        value.matches("^([Cc]omputer([ -]?[Ee]ngineering)?|[Cc][.]?[Pp][.]?[Ee][.]?|[Bb][Ss][Cc][Pp][Ee])$") ? "Computer Engineering" :
        value.matches("^([Ii]ndustrial([ -]?[Ee]ngineering)?|[Ii][.]?[Ee][.]?|[Bb][Ss][Ii][Ee])$") ? "Industrial Engineering" :
        null;
    }

    function inferCourseScopeFromPosition(position) {
      return position == "B.O.D. (ME)" ? "Mechanical Engineering" :
        position == "B.O.D. (EE)" ? "Electrical Engineering" :
        position == "B.O.D. (IE)" ? "Industrial Engineering" :
        position == "B.O.D. (CPE)" ? "Computer Engineering" :
        position == "B.O.D. (ECE)" ? "Electronics Engineering" :
        null;
    }

    function courseScopeFromAssignedCourse(courseCode) {
      return normalizeCourseScopeValue(courseCode);
    }

    function isAllScopeECPosition(position) {
      return position == "President" ||
        position == "Vice President" ||
        position == "Secretary" ||
        position == "Treasurer" ||
        position == "Auditor" ||
        position == "P.I.O." ||
        position == "H.A.S.";
    }

    function isBODPosition(position) {
      return position == "B.O.D." ||
        position == "B.O.D. (ME)" ||
        position == "B.O.D. (EE)" ||
        position == "B.O.D. (IE)" ||
        position == "B.O.D. (CPE)" ||
        position == "B.O.D. (ECE)";
    }

    function hasBodCourseMarkers(data) {
      return data != null &&
        (
          normalizeCourseScopeValue(data.courseScope) != null ||
          normalizeCourseScopeValue(data.courseScopeLabel) != null ||
          courseScopeFromAssignedCourse(data.assignedCourse) != null ||
          inferCourseScopeFromPosition(data.ecPosition) != null
        );
    }

    function courseScopeSlugFromValue(courseScope) {
      return courseScope == "Mechanical Engineering" ||
        courseScope == "mechanical-engineering" ||
        courseScope == "ME" ||
        courseScope == "BSME" ?
        "mechanical-engineering" :
        courseScope == "Electrical Engineering" ||
          courseScope == "electrical-engineering" ||
          courseScope == "EE" ||
          courseScope == "BSEE" ?
          "electrical-engineering" :
          courseScope == "Industrial Engineering" ||
            courseScope == "industrial-engineering" ||
            courseScope == "IE" ||
            courseScope == "BSIE" ?
            "industrial-engineering" :
            courseScope == "Computer Engineering" ||
              courseScope == "computer-engineering" ||
              courseScope == "CPE" ||
              courseScope == "BSCpE" ?
              "computer-engineering" :
              courseScope == "Electronics Engineering" ||
                courseScope == "electronics-engineering" ||
                courseScope == "ECE" ||
                courseScope == "BSECE" ?
                "electronics-engineering" :
        "";
    }

    function currentCourseScope() {
      return !hasProfile() || !isBOD() ? null :
        normalizeCourseScopeValue(profile().courseScopeLabel) != null ?
        normalizeCourseScopeValue(profile().courseScopeLabel) :
        normalizeCourseScopeValue(profile().course) != null ?
        normalizeCourseScopeValue(profile().course) :
        courseScopeFromAssignedCourse(profile().assignedCourse) != null ?
        courseScopeFromAssignedCourse(profile().assignedCourse) :
        inferCourseScopeFromPosition(profile().ecPosition) != null ?
        inferCourseScopeFromPosition(profile().ecPosition) :
        normalizeCourseScopeValue(profile().courseScope);
    }

    function currentCourseScopeSlug() {
      return currentCourseScope() != null ? courseScopeSlugFromValue(currentCourseScope()) : "";
    }

    function isBOD() {
      return hasProfile() &&
        (
          role() == "bod" ||
          (
            isECMemberRole(role()) &&
            (
              profile().ecScope == "course" ||
              (
                profile().ecScope != "all" &&
                (
                  profile().isBod == true ||
                  isBODPosition(profile().ecPosition) ||
                  (
                    !isAllScopeECPosition(profile().ecPosition) &&
                    hasBodCourseMarkers(profile())
                  )
                )
              )
            )
          )
        );
    }

    function isRegularEC() {
      return hasProfile() &&
        isRegularECMemberRole(role()) &&
        (profile().ecScope == "all" || !isBOD());
    }

    function isTeacher() {
      return signedIn() && role() == "teacher";
    }

    function isAdminOrEC() {
      return isAdmin() || isEC();
    }

    function eventExists(eventId) {
      return firestore.exists(eventPath(eventId));
    }

    function eventData(eventId) {
      return eventExists(eventId) ? firestore.get(eventPath(eventId)).data : null;
    }

    function ecDocumentExists(docId) {
      return firestore.exists(ecDocumentPath(docId));
    }

    function ecDocumentData(docId) {
      return ecDocumentExists(docId) ? firestore.get(ecDocumentPath(docId)).data : null;
    }

    function ecDocumentOwnerType(data) {
      return data != null && data.ownerType == "bod" ? "bod" : "ec";
    }

    function ecDocumentOwnerMatchesCurrentUser(data) {
      return data != null &&
        (
          data.createdBy == request.auth.uid ||
          data.createdByUid == request.auth.uid ||
          data.uploadedByUid == request.auth.uid ||
          data.ownerUid == request.auth.uid ||
          data.uploadedBy == request.auth.uid
        );
    }

    function ecDocumentCourseScope(data) {
      return data != null &&
        normalizeCourseScopeValue(data.courseScope) != null ?
        normalizeCourseScopeValue(data.courseScope) :
        data != null &&
          normalizeCourseScopeValue(data.courseScopeSlug) != null ?
          normalizeCourseScopeValue(data.courseScopeSlug) :
          data != null &&
          normalizeCourseScopeValue(data.createdByCourseScope) != null ?
          normalizeCourseScopeValue(data.createdByCourseScope) :
          (
            data != null ?
              normalizeCourseScopeValue(data.course) :
              null
          );
    }

    function bodCoursePathMatchesCurrentScope(pathCourseScopeSlug) {
      return isBOD() &&
        currentCourseScope() != null &&
        currentCourseScopeSlug() != "" &&
        pathCourseScopeSlug == currentCourseScopeSlug();
    }

    function ecDocumentStoredCourseScopeSlug(data) {
      return data != null &&
        data.courseScopeSlug is string ?
        data.courseScopeSlug :
        "";
    }

    function ecDocumentStatus(data) {
      return data != null &&
        data.status is string &&
        data.status == "pending-upload" ?
        "pending-upload" :
        "active";
    }

    function ecDocumentStoragePathMatchesCoursePath(data, pathCourseScopeSlug, docId, fileName) {
      return data != null &&
        data.storagePath is string &&
        (
          data.storagePath == "documents/course/" + pathCourseScopeSlug + "/" + docId + "/" + fileName ||
          data.storagePath == "ec-documents/course/" + pathCourseScopeSlug + "/" + docId + "/" + fileName
        );
    }

    function ecDocumentCourseScopeSlugMatchesScope(data) {
      return data == null ||
        ecDocumentStoredCourseScopeSlug(data) == "" ||
        ecDocumentStoredCourseScopeSlug(data) == currentCourseScopeSlug();
    }

    function ecDocumentCourseScopeSlugMatchesPath(data, pathCourseScopeSlug) {
      return data == null ||
        ecDocumentStoredCourseScopeSlug(data) == "" ||
        ecDocumentStoredCourseScopeSlug(data) == pathCourseScopeSlug;
    }

    function bodEcDocumentMatchesCurrentOwnerAndScope(data, pathCourseScopeSlug, docId, fileName) {
      return bodCoursePathMatchesCurrentScope(pathCourseScopeSlug) &&
        data != null &&
        ecDocumentOwnerType(data) == "bod" &&
        ecDocumentOwnerMatchesCurrentUser(data) &&
        ecDocumentCourseScopeSlugMatchesScope(data) &&
        ecDocumentCourseScopeSlugMatchesPath(data, pathCourseScopeSlug) &&
        ecDocumentStoragePathMatchesCoursePath(data, pathCourseScopeSlug, docId, fileName) &&
        ecDocumentCourseScope(data) == currentCourseScope();
    }

    function canReadOwnBodEcDocumentAtPath(docId, pathCourseScopeSlug, fileName) {
      return signedIn() &&
        ecDocumentExists(docId) &&
        ecDocumentStatus(ecDocumentData(docId)) != "pending-upload" &&
        bodEcDocumentMatchesCurrentOwnerAndScope(
          ecDocumentData(docId),
          pathCourseScopeSlug,
          docId,
          fileName
        );
    }

    function canCreatePendingBodEcDocumentAtPath(docId, pathCourseScopeSlug, fileName) {
      return signedIn() &&
        ecDocumentExists(docId) &&
        ecDocumentStatus(ecDocumentData(docId)) == "pending-upload" &&
        bodEcDocumentMatchesCurrentOwnerAndScope(
          ecDocumentData(docId),
          pathCourseScopeSlug,
          docId,
          fileName
        );
    }

    function eventOwnerType(data) {
      return data.ownerType == "bod" ? "bod" : "ec";
    }

    function eventCourseScope(data) {
      return normalizeCourseScopeValue(data.courseScope) != null ?
        normalizeCourseScopeValue(data.courseScope) :
        normalizeCourseScopeValue(data.createdByCourseScope) != null ?
        normalizeCourseScopeValue(data.createdByCourseScope) :
        normalizeCourseScopeValue(data.course);
    }

    function canReadCourseDocumentAtPath(docId, pathCourseScopeSlug, fileName) {
      return isAdmin() || isRegularEC() ||
        canReadOwnBodEcDocumentAtPath(docId, pathCourseScopeSlug, fileName);
    }

    function canWriteCourseDocumentAtPath(docId, pathCourseScopeSlug, fileName) {
      return isAdmin() || isRegularEC() ||
        canCreatePendingBodEcDocumentAtPath(docId, pathCourseScopeSlug, fileName) ||
        canReadOwnBodEcDocumentAtPath(docId, pathCourseScopeSlug, fileName);
    }

    function canViewEventData(data) {
      return !isEC() ? signedIn() :
        isAdmin() || isRegularEC() ||
        (
          isBOD() &&
          (
            eventOwnerType(data) == "ec" ||
            (
              currentCourseScope() != null &&
              eventCourseScope(data) == currentCourseScope()
            )
          )
        );
    }

    function canEditEventFiles(eventId) {
      return eventExists(eventId) &&
        (
          isAdmin() ||
          isRegularEC() ||
          (
            isBOD() &&
            currentCourseScope() != null &&
            eventOwnerType(eventData(eventId)) == "bod" &&
            eventCourseScope(eventData(eventId)) == currentCourseScope() &&
            eventData(eventId).createdBy == request.auth.uid
          )
        );
    }

    match /ec-documents/shared/{docId}/{fileName} {
      allow read: if isAdmin() || isRegularEC();
      allow write: if isAdmin() || isRegularEC();
    }

    match /ec-documents/course/{pathCourseScopeSlug}/{docId}/{fileName} {
      allow read: if canReadCourseDocumentAtPath(docId, pathCourseScopeSlug, fileName);
      allow write: if canWriteCourseDocumentAtPath(docId, pathCourseScopeSlug, fileName);
    }

    match /documents/shared/{docId}/{fileName} {
      allow read: if isAdmin() || isRegularEC();
      allow write: if isAdmin() || isRegularEC();
    }

    match /documents/course/{pathCourseScopeSlug}/{docId}/{fileName} {
      allow read: if canReadCourseDocumentAtPath(docId, pathCourseScopeSlug, fileName);
      allow write: if canWriteCourseDocumentAtPath(docId, pathCourseScopeSlug, fileName);
    }

    match /events/{eventId}/images/{fileId} {
      allow read: if eventExists(eventId) && canViewEventData(eventData(eventId));
      allow write: if canEditEventFiles(eventId);
    }

    match /events/{eventId}/docs/{fileId} {
      allow read: if isTeacher() ||
        (eventExists(eventId) && canViewEventData(eventData(eventId)));
      allow write: if canEditEventFiles(eventId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
