rules_version = "2";
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/(default)/documents/profiles/$(request.auth.uid);
    }

    function role() {
      return signedIn() && firestore.exists(profilePath())
        ? firestore.get(profilePath()).data.role
        : "";
    }

    function isAdmin() {
      return signedIn() && role() == "admin";
    }

    function isEC() {
      return signedIn() && role() == "ec";
    }

    function isTeacher() {
      return signedIn() && role() == "teacher";
    }

    function isAdminOrEC() {
      return isAdmin() || isEC();
    }

    // Shared EC document storage:
    // ec-documents/shared/{docId}/{fileName}
    match /ec-documents/shared/{docId}/{fileName} {
      allow read, write: if isAdminOrEC();
    }

    // Event image storage:
    // events/{eventId}/images/{fileId}
    match /events/{eventId}/images/{fileId} {
      allow read: if signedIn();
      allow write: if isAdminOrEC();
    }

    // Event document storage:
    // events/{eventId}/docs/{fileId}
    match /events/{eventId}/docs/{fileId} {
      allow read: if isAdminOrEC() || isTeacher();
      allow write: if isAdminOrEC();
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
