rules_version = "2";
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/(default)/documents/profiles/$(request.auth.uid);
    }

    function eventPath(eventId) {
      return /databases/(default)/documents/events/$(eventId);
    }

    function ecDocumentPath(docId) {
      return /databases/(default)/documents/ecDocuments/$(docId);
    }

    function hasProfile() {
      return signedIn() && firestore.exists(profilePath());
    }

    function profile() {
      return hasProfile() ? firestore.get(profilePath()).data : null;
    }

    function role() {
      return hasProfile() ? profile().role : "";
    }

    function isAdmin() {
      return signedIn() && role() == "admin";
    }

    function isRegularECMemberRole(value) {
      return value == "ec" || value == "ecmember";
    }

    function isBodRole(value) {
      return value == "bod";
    }

    function isECMemberRole(value) {
      return isRegularECMemberRole(value) || isBodRole(value);
    }

    function isEC() {
      return signedIn() && isECMemberRole(role());
    }

    // Accept both human-readable labels and historical slug/code variants.
    function normalizeCourseScopeValue(value) {
      return !(value is string) || value == "" ? null :
        value.matches("^([Mm]echanical([ -]?[Ee]ngineering)?|[Mm][.]?[Ee][.]?|[Bb][Ss][Mm][Ee])$") ? "Mechanical Engineering" :
        value.matches("^([Ee]lectrical([ -]?[Ee]ngineering)?|[Ee][.]?[Ee][.]?|[Bb][Ss][Ee][Ee])$") ? "Electrical Engineering" :
        value.matches("^([Ee]lectronics([ -]?[Ee]ngineering)?|[Ee]lectronics[ -]?[Aa]nd[ -]?[Cc]ommunications([ -]?[Ee]ngineering)?|[Ee][.]?[Cc][.]?[Ee][.]?|[Bb][Ss][Ee][Cc][Ee])$") ? "Electronics Engineering" :
        value.matches("^([Cc]omputer([ -]?[Ee]ngineering)?|[Cc][.]?[Pp][.]?[Ee][.]?|[Bb][Ss][Cc][Pp][Ee])$") ? "Computer Engineering" :
        value.matches("^([Ii]ndustrial([ -]?[Ee]ngineering)?|[Ii][.]?[Ee][.]?|[Bb][Ss][Ii][Ee])$") ? "Industrial Engineering" :
        null;
    }

    function inferCourseScopeFromPosition(position) {
      return position == "B.O.D. (ME)" ? "Mechanical Engineering" :
        position == "B.O.D. (EE)" ? "Electrical Engineering" :
        position == "B.O.D. (IE)" ? "Industrial Engineering" :
        position == "B.O.D. (CPE)" ? "Computer Engineering" :
        position == "B.O.D. (ECE)" ? "Electronics Engineering" :
        null;
    }

    function courseScopeFromAssignedCourse(courseCode) {
      return normalizeCourseScopeValue(courseCode);
    }

    function isAllScopeECPosition(position) {
      return position == "President" ||
        position == "Vice President" ||
        position == "Secretary" ||
        position == "Treasurer" ||
        position == "Auditor" ||
        position == "P.I.O." ||
        position == "H.A.S.";
    }

    function isBODPosition(position) {
      return position == "B.O.D." ||
        position == "B.O.D. (ME)" ||
        position == "B.O.D. (EE)" ||
        position == "B.O.D. (IE)" ||
        position == "B.O.D. (CPE)" ||
        position == "B.O.D. (ECE)";
    }

    function hasBodCourseMarkers(data) {
      return data != null &&
        (
          normalizeCourseScopeValue(data.courseScope) != null ||
          normalizeCourseScopeValue(data.courseScopeLabel) != null ||
          courseScopeFromAssignedCourse(data.assignedCourse) != null ||
          inferCourseScopeFromPosition(data.ecPosition) != null
        );
    }

    function courseScopeSlugFromValue(courseScope) {
      return courseScope == "Mechanical Engineering" ||
        courseScope == "mechanical-engineering" ||
        courseScope == "ME" ||
        courseScope == "BSME" ?
        "mechanical-engineering" :
        courseScope == "Electrical Engineering" ||
          courseScope == "electrical-engineering" ||
          courseScope == "EE" ||
          courseScope == "BSEE" ?
          "electrical-engineering" :
          courseScope == "Industrial Engineering" ||
            courseScope == "industrial-engineering" ||
            courseScope == "IE" ||
            courseScope == "BSIE" ?
            "industrial-engineering" :
            courseScope == "Computer Engineering" ||
              courseScope == "computer-engineering" ||
              courseScope == "CPE" ||
              courseScope == "BSCpE" ?
              "computer-engineering" :
              courseScope == "Electronics Engineering" ||
                courseScope == "electronics-engineering" ||
                courseScope == "ECE" ||
                courseScope == "BSECE" ?
                "electronics-engineering" :
        "";
    }

    function currentCourseScope() {
      return !hasProfile() || !isBOD() ? null :
        normalizeCourseScopeValue(profile().courseScopeLabel) != null ?
        normalizeCourseScopeValue(profile().courseScopeLabel) :
        normalizeCourseScopeValue(profile().course) != null ?
        normalizeCourseScopeValue(profile().course) :
        courseScopeFromAssignedCourse(profile().assignedCourse) != null ?
        courseScopeFromAssignedCourse(profile().assignedCourse) :
        inferCourseScopeFromPosition(profile().ecPosition) != null ?
        inferCourseScopeFromPosition(profile().ecPosition) :
        normalizeCourseScopeValue(profile().courseScope);
    }

    function currentCourseScopeSlug() {
      return currentCourseScope() != null ? courseScopeSlugFromValue(currentCourseScope()) : "";
    }

    function isBOD() {
      return hasProfile() &&
        (
          role() == "bod" ||
          (
            isECMemberRole(role()) &&
            (
              profile().ecScope == "course" ||
              (
                profile().ecScope != "all" &&
                (
                  profile().isBod == true ||
                  isBODPosition(profile().ecPosition) ||
                  (
                    !isAllScopeECPosition(profile().ecPosition) &&
                    hasBodCourseMarkers(profile())
                  )
                )
              )
            )
          )
        );
    }

    function isRegularEC() {
      return hasProfile() &&
        isRegularECMemberRole(role()) &&
        (profile().ecScope == "all" || !isBOD());
    }

    function isTeacher() {
      return signedIn() && role() == "teacher";
    }

    function isAdminOrEC() {
      return isAdmin() || isEC();
    }

    function eventExists(eventId) {
      return firestore.exists(eventPath(eventId));
    }

    function eventData(eventId) {
      return eventExists(eventId) ? firestore.get(eventPath(eventId)).data : null;
    }

    function eventIsCancelled(eventId) {
      return eventExists(eventId) &&
        (
          eventData(eventId).cancelled == true ||
          eventData(eventId).status == "cancelled"
        );
    }

    function ecDocumentExists(docId) {
      return firestore.exists(ecDocumentPath(docId));
    }

    function ecDocumentData(docId) {
      return ecDocumentExists(docId) ? firestore.get(ecDocumentPath(docId)).data : null;
    }

    function ecDocumentOwnerType(data) {
      return data != null && data.ownerType == "bod" ? "bod" : "ec";
    }

    function ecDocumentOwnerMatchesCurrentUser(data) {
      return data != null &&
        (
          data.createdBy == request.auth.uid ||
          data.createdByUid == request.auth.uid ||
          data.uploadedByUid == request.auth.uid ||
          data.ownerUid == request.auth.uid ||
          data.uploadedBy == request.auth.uid
        );
    }

    function ecDocumentCourseScope(data) {
      return data != null &&
        normalizeCourseScopeValue(data.courseScope) != null ?
        normalizeCourseScopeValue(data.courseScope) :
        data != null &&
          normalizeCourseScopeValue(data.courseScopeSlug) != null ?
          normalizeCourseScopeValue(data.courseScopeSlug) :
          data != null &&
          normalizeCourseScopeValue(data.createdByCourseScope) != null ?
          normalizeCourseScopeValue(data.createdByCourseScope) :
          (
            data != null ?
              normalizeCourseScopeValue(data.course) :
              null
          );
    }

    function bodCoursePathMatchesCurrentScope(pathCourseScopeSlug) {
      return isBOD() &&
        currentCourseScope() != null &&
        currentCourseScopeSlug() != "" &&
        pathCourseScopeSlug == currentCourseScopeSlug();
    }

    function ecDocumentStoredCourseScopeSlug(data) {
      return data != null &&
        data.courseScopeSlug is string ?
        data.courseScopeSlug :
        "";
    }

    function ecDocumentStatus(data) {
      return data != null &&
        data.status is string &&
        data.status == "pending-upload" ?
        "pending-upload" :
        "active";
    }

    function ecDocumentStoragePathMatchesCoursePath(data, pathCourseScopeSlug, docId, fileName) {
      return data != null &&
        data.storagePath is string &&
        (
          data.storagePath == "documents/course/" + pathCourseScopeSlug + "/" + docId + "/" + fileName ||
          data.storagePath == "ec-documents/course/" + pathCourseScopeSlug + "/" + docId + "/" + fileName
        );
    }

    function ecDocumentCourseScopeSlugMatchesScope(data) {
      return data == null ||
        ecDocumentStoredCourseScopeSlug(data) == "" ||
        ecDocumentStoredCourseScopeSlug(data) == currentCourseScopeSlug();
    }

    function ecDocumentCourseScopeSlugMatchesPath(data, pathCourseScopeSlug) {
      return data == null ||
        ecDocumentStoredCourseScopeSlug(data) == "" ||
        ecDocumentStoredCourseScopeSlug(data) == pathCourseScopeSlug;
    }

    function bodEcDocumentMatchesCurrentOwnerAndScope(data, pathCourseScopeSlug, docId, fileName) {
      return bodCoursePathMatchesCurrentScope(pathCourseScopeSlug) &&
        data != null &&
        ecDocumentOwnerType(data) == "bod" &&
        ecDocumentOwnerMatchesCurrentUser(data) &&
        ecDocumentCourseScopeSlugMatchesScope(data) &&
        ecDocumentCourseScopeSlugMatchesPath(data, pathCourseScopeSlug) &&
        ecDocumentStoragePathMatchesCoursePath(data, pathCourseScopeSlug, docId, fileName) &&
        ecDocumentCourseScope(data) == currentCourseScope();
    }

    function canReadOwnBodEcDocumentAtPath(docId, pathCourseScopeSlug, fileName) {
      return signedIn() &&
        ecDocumentExists(docId) &&
        ecDocumentStatus(ecDocumentData(docId)) != "pending-upload" &&
        bodEcDocumentMatchesCurrentOwnerAndScope(
          ecDocumentData(docId),
          pathCourseScopeSlug,
          docId,
          fileName
        );
    }

    function canCreatePendingBodEcDocumentAtPath(docId, pathCourseScopeSlug, fileName) {
      return signedIn() &&
        ecDocumentExists(docId) &&
        ecDocumentStatus(ecDocumentData(docId)) == "pending-upload" &&
        bodEcDocumentMatchesCurrentOwnerAndScope(
          ecDocumentData(docId),
          pathCourseScopeSlug,
          docId,
          fileName
        );
    }

    function eventOwnerType(data) {
      return data.ownerType == "bod" ? "bod" : "ec";
    }

    function eventCourseScope(data) {
      return normalizeCourseScopeValue(data.courseScope) != null ?
        normalizeCourseScopeValue(data.courseScope) :
        normalizeCourseScopeValue(data.createdByCourseScope) != null ?
        normalizeCourseScopeValue(data.createdByCourseScope) :
        normalizeCourseScopeValue(data.course);
    }

    function eventCreatedByMatchesCurrentUser(data) {
      return data != null &&
        (
          data.createdBy == request.auth.uid ||
          data.createdByUid == request.auth.uid
        );
    }

    function eventCreatedByCourseScopeValue(data) {
      return data != null &&
        normalizeCourseScopeValue(data.createdByCourseScope) != null ?
        normalizeCourseScopeValue(data.createdByCourseScope) :
        null;
    }

    function eventDocumentPath(eventId, docId) {
      return /databases/(default)/documents/events/$(eventId)/docs/$(docId);
    }

    function eventDocumentExists(eventId, docId) {
      return firestore.exists(eventDocumentPath(eventId, docId));
    }

    function eventDocumentData(eventId, docId) {
      return eventDocumentExists(eventId, docId) ?
        firestore.get(eventDocumentPath(eventId, docId)).data :
        null;
    }

    function eventDocumentStoragePathValue(data) {
      return data != null &&
        data.storagePath is string &&
        data.storagePath != "" ?
        data.storagePath :
        (
          data != null &&
          data.path is string &&
          data.path != ""
        ) ?
          data.path :
          "";
    }

    function expectedEventDocumentStoragePath(eventId, docId, fileName) {
      return "events/" + eventId + "/docs/" + docId + "/" + fileName;
    }

    function eventDocumentPathMatchesObject(data, eventId, docId, fileName) {
      let expectedPath = expectedEventDocumentStoragePath(eventId, docId, fileName);
      let storagePath = eventDocumentStoragePathValue(data);
      return storagePath != "" && storagePath == expectedPath;
    }

    function eventDocumentStatusAllowsRead(data) {
      return data != null &&
        (
          !(data.status is string) ||
          data.status == "active"
        );
    }

    function eventDocumentMetadataOwnerMatchesCurrentUser(data) {
      return data != null &&
        (
          (data.uid is string && data.uid == request.auth.uid) ||
          (data.createdByUid is string && data.createdByUid == request.auth.uid) ||
          (data.createdBy is string && data.createdBy == request.auth.uid) ||
          (data.uploadedByUid is string && data.uploadedByUid == request.auth.uid) ||
          (data.uploadedBy is string && data.uploadedBy == request.auth.uid) ||
          (data.ownerUid is string && data.ownerUid == request.auth.uid)
        );
    }

    function canReadCourseDocumentAtPath(docId, pathCourseScopeSlug, fileName) {
      return isAdmin() || isRegularEC() ||
        canReadOwnBodEcDocumentAtPath(docId, pathCourseScopeSlug, fileName);
    }

    function canWriteCourseDocumentAtPath(docId, pathCourseScopeSlug, fileName) {
      return isAdmin() || isRegularEC() ||
        canCreatePendingBodEcDocumentAtPath(docId, pathCourseScopeSlug, fileName) ||
        canReadOwnBodEcDocumentAtPath(docId, pathCourseScopeSlug, fileName);
    }

    function canViewEventData(data) {
      return !isEC() ? signedIn() :
        isAdmin() || isRegularEC() ||
        (
          isBOD() &&
          (
            eventOwnerType(data) == "ec" ||
            (
              currentCourseScope() != null &&
              eventCourseScope(data) == currentCourseScope()
            )
          )
        );
    }

    function canEditEventFiles(eventId) {
      return eventExists(eventId) &&
        (
          isAdmin() ||
          isRegularEC() ||
          (
            isBOD() &&
            currentCourseScope() != null &&
            eventOwnerType(eventData(eventId)) == "bod" &&
            eventCourseScope(eventData(eventId)) == currentCourseScope() &&
            eventCreatedByMatchesCurrentUser(eventData(eventId))
          )
        );
    }

    function teacherUploadEventIsAllowed(eventId) {
      return eventExists(eventId) &&
        !eventIsCancelled(eventId) &&
        canViewEventData(eventData(eventId));
    }

    function eventImageFileNameHasAllowedExtension(fileName) {
      return fileName.matches("^.+\\.(jpg|JPG|jpeg|JPEG|png|PNG|webp|WEBP)$");
    }

    function isAllowedEventImageUploadContentType(fileName, contentType) {
      return eventImageFileNameHasAllowedExtension(fileName) &&
        (
          contentType == "image/jpeg" ||
          contentType == "image/png" ||
          contentType == "image/webp"
        );
    }

    function isAllowedEventImageContent(fileName) {
      return request.resource != null &&
        request.resource.size <= 10 * 1024 * 1024 &&
        isAllowedEventImageUploadContentType(fileName, request.resource.contentType);
    }

    function pendingEventUploadOwnedByCurrentUser(data) {
      return data != null &&
        (
          (data.uid is string && data.uid == request.auth.uid) ||
          data.createdByUid == request.auth.uid ||
          data.createdBy == request.auth.uid ||
          data.uploadedByUid == request.auth.uid ||
          data.uploadedBy == request.auth.uid ||
          data.ownerUid == request.auth.uid
        );
    }

    function pendingUploadRole(data) {
      return data != null &&
        data.uploadedByRole is string &&
        data.uploadedByRole != "" ?
        data.uploadedByRole :
        data != null &&
          data.role is string &&
          data.role != "" ?
          data.role :
        "";
    }

    function pendingEventUploadRoleCanUseTarget(data) {
      let uploadedByRole = pendingUploadRole(data);
      return uploadedByRole == "teacher" ||
        uploadedByRole == "admin" ||
        uploadedByRole == "ecmember" ||
        uploadedByRole == "ec" ||
        uploadedByRole == "bod";
    }

    function canUsePendingEventFileUploadForEvent(eventId, data) {
      return (
          isAdmin() ||
          isRegularEC() ||
          isBOD() ||
          isTeacher() ||
          (
            pendingEventUploadOwnedByCurrentUser(data) &&
            pendingEventUploadRoleCanUseTarget(data)
          )
        ) &&
        (
          !(isTeacher() || pendingUploadRole(data) == "teacher") ||
          teacherUploadEventIsAllowed(eventId)
        );
    }

    function eventImageDocumentPath(eventId, imageId) {
      return /databases/(default)/documents/events/$(eventId)/images/$(imageId);
    }

    function eventImageDocumentExists(eventId, imageId) {
      return firestore.exists(eventImageDocumentPath(eventId, imageId));
    }

    function eventImageDocumentData(eventId, imageId) {
      return eventImageDocumentExists(eventId, imageId) ?
        firestore.get(eventImageDocumentPath(eventId, imageId)).data :
        null;
    }

    function eventImageStoragePathValue(data) {
      return data != null &&
        data.storagePath is string &&
        data.storagePath != "" ?
        data.storagePath :
        (
          data != null &&
          data.path is string &&
          data.path != ""
        ) ?
          data.path :
          "";
    }

    function expectedEventImageStoragePath(eventId, imageId, fileName) {
      return "events/" + eventId + "/images/" + imageId + "/" + fileName;
    }

    function eventImagePathMatchesObject(data, eventId, imageId, fileName) {
      let expectedPath = expectedEventImageStoragePath(eventId, imageId, fileName);
      let storagePath = eventImageStoragePathValue(data);
      return storagePath != "" && storagePath == expectedPath;
    }

    function eventImageStatusAllowsRead(data) {
      return data != null &&
        (
          !(data.status is string) ||
          data.status == "active"
        );
    }

    function eventImageStatus(data) {
      return data != null &&
        data.status is string &&
        data.status == "pending-upload" ?
        "pending-upload" :
        "active";
    }

    function eventImageOwnedByCurrentUser(data) {
      return data != null &&
        (
          (data.uid is string && data.uid == request.auth.uid) ||
          data.createdByUid == request.auth.uid ||
          data.createdBy == request.auth.uid ||
          data.uploadedByUid == request.auth.uid ||
          data.uploadedBy == request.auth.uid ||
          data.ownerUid == request.auth.uid
        );
    }

    function eventImageStoragePathMatchesUpload(data, eventId, imageId, fileName) {
      return data != null &&
        data.storagePath is string &&
        data.storagePath == expectedEventImageStoragePath(eventId, imageId, fileName);
    }

    function eventImagePendingContentTypeIsAllowed(data, fileName) {
      return data != null &&
        data.contentType is string &&
        isAllowedEventImageUploadContentType(fileName, data.contentType);
    }

    function eventImageRequestContentTypeMatchesPending(data, fileName) {
      return request.resource != null &&
        data != null &&
        data.contentType is string &&
        data.contentType == request.resource.contentType &&
        isAllowedEventImageUploadContentType(fileName, request.resource.contentType);
    }

    function canReadEventImageObject(eventId, imageId, fileName) {
      return signedIn() &&
        eventExists(eventId) &&
        eventImageDocumentExists(eventId, imageId) &&
        eventImagePathMatchesObject(
          eventImageDocumentData(eventId, imageId),
          eventId,
          imageId,
          fileName
        ) &&
        eventImageStatusAllowsRead(eventImageDocumentData(eventId, imageId)) &&
        canViewEventData(eventData(eventId));
    }

    function canCreateOrUpdatePendingEventImage(eventId, imageId, fileName) {
      return signedIn() &&
        eventExists(eventId) &&
        eventImageDocumentExists(eventId, imageId) &&
        canUsePendingEventFileUploadForEvent(
          eventId,
          eventImageDocumentData(eventId, imageId)
        ) &&
        eventImageStatus(eventImageDocumentData(eventId, imageId)) == "pending-upload" &&
        eventImageOwnedByCurrentUser(eventImageDocumentData(eventId, imageId)) &&
        eventImageDocumentData(eventId, imageId).eventId == eventId &&
        eventImagePendingContentTypeIsAllowed(
          eventImageDocumentData(eventId, imageId),
          fileName
        ) &&
        eventImageStoragePathMatchesUpload(
          eventImageDocumentData(eventId, imageId),
          eventId,
          imageId,
          fileName
        ) &&
        eventImageRequestContentTypeMatchesPending(
          eventImageDocumentData(eventId, imageId),
          fileName
        ) &&
        isAllowedEventImageContent(fileName);
    }

    function eventDocumentFileNameHasAllowedExtension(fileName) {
      return fileName.matches("^.+\\.(pdf|PDF|doc|DOC|docx|DOCX)$");
    }

    function isAllowedEventDocumentUploadContentType(fileName, contentType) {
      return contentType == "application/pdf" ||
        contentType == "application/msword" ||
        contentType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document" ||
        (
          eventDocumentFileNameHasAllowedExtension(fileName) &&
          (
            contentType == "application/octet-stream" ||
            contentType == ""
          )
        );
    }

    function eventDocumentPendingContentTypeIsAllowed(data, fileName) {
      return data != null &&
        data.contentType is string &&
        isAllowedEventDocumentUploadContentType(fileName, data.contentType);
    }

    function eventDocumentRequestContentTypeMatchesPending(data, fileName) {
      return request.resource != null &&
        data != null &&
        data.contentType is string &&
        (
          data.contentType == request.resource.contentType ||
          (
            eventDocumentFileNameHasAllowedExtension(fileName) &&
            eventDocumentPendingContentTypeIsAllowed(data, fileName) &&
            isAllowedEventDocumentUploadContentType(fileName, request.resource.contentType) &&
            (
              data.contentType == "application/octet-stream" ||
              data.contentType == "" ||
              request.resource.contentType == "application/octet-stream" ||
              request.resource.contentType == ""
            )
          )
        );
    }

    function isAllowedEventDocumentContent(fileName) {
      return request.resource != null &&
        request.resource.size <= 10 * 1024 * 1024 &&
        isAllowedEventDocumentUploadContentType(fileName, request.resource.contentType);
    }

    function eventDocumentStatus(data) {
      return data != null &&
        data.status is string &&
        data.status == "pending-upload" ?
        "pending-upload" :
        "active";
    }

    function eventDocumentOwnedByCurrentUser(data) {
      return data != null &&
        (
          (data.uid is string && data.uid == request.auth.uid) ||
          data.createdByUid == request.auth.uid ||
          data.createdBy == request.auth.uid ||
          data.uploadedByUid == request.auth.uid ||
          data.uploadedBy == request.auth.uid ||
          data.ownerUid == request.auth.uid
        );
    }

    function eventDocumentStoragePathMatchesUpload(data, eventId, docId, fileName) {
      return data != null &&
        data.storagePath is string &&
        data.storagePath == "events/" + eventId + "/docs/" + docId + "/" + fileName;
    }

    function canReadEventDocument(eventId) {
      return eventExists(eventId) &&
        (
          isTeacher() ||
          isAdmin() ||
          isRegularEC() ||
          (
            isBOD() &&
            canEditEventFiles(eventId)
          )
        );
    }

    function canReadEventDocumentObject(eventId, docId, fileName) {
      let parentEvent = eventData(eventId);
      let documentData = eventDocumentData(eventId, docId);
      let parentEventCourseScope = eventCourseScope(parentEvent);
      let parentCreatedByCourseScope = eventCreatedByCourseScopeValue(parentEvent);

      return signedIn() &&
        eventExists(eventId) &&
        eventDocumentExists(eventId, docId) &&
        eventDocumentPathMatchesObject(documentData, eventId, docId, fileName) &&
        eventDocumentStatusAllowsRead(documentData) &&
        (
          isTeacher() ||
          isAdmin() ||
          isRegularEC() ||
          (
            isBOD() &&
            currentCourseScope() != null &&
            eventOwnerType(parentEvent) == "bod" &&
            (
              parentEventCourseScope == currentCourseScope() ||
              parentCreatedByCourseScope == currentCourseScope()
            ) &&
            (
              eventDocumentMetadataOwnerMatchesCurrentUser(documentData) ||
              eventCreatedByMatchesCurrentUser(parentEvent)
            )
          )
        );
    }

    function canCreateOrUpdatePendingEventDocument(eventId, docId, fileName) {
      return signedIn() &&
        eventExists(eventId) &&
        !eventIsCancelled(eventId) &&
        eventDocumentExists(eventId, docId) &&
        canUsePendingEventFileUploadForEvent(
          eventId,
          eventDocumentData(eventId, docId)
        ) &&
        eventDocumentStatus(eventDocumentData(eventId, docId)) == "pending-upload" &&
        eventDocumentOwnedByCurrentUser(eventDocumentData(eventId, docId)) &&
        eventDocumentData(eventId, docId).eventId == eventId &&
        eventDocumentPendingContentTypeIsAllowed(
          eventDocumentData(eventId, docId),
          fileName
        ) &&
        eventDocumentStoragePathMatchesUpload(
          eventDocumentData(eventId, docId),
          eventId,
          docId,
          fileName
        ) &&
        eventDocumentRequestContentTypeMatchesPending(
          eventDocumentData(eventId, docId),
          fileName
        ) &&
        isAllowedEventDocumentContent(fileName);
    }

    match /ec-documents/shared/{docId}/{fileName} {
      allow read: if isAdmin() || isRegularEC();
      allow write: if isAdmin() || isRegularEC();
    }

    match /ec-documents/course/{pathCourseScopeSlug}/{docId}/{fileName} {
      allow read: if canReadCourseDocumentAtPath(docId, pathCourseScopeSlug, fileName);
      allow write: if canWriteCourseDocumentAtPath(docId, pathCourseScopeSlug, fileName);
    }

    match /documents/shared/{docId}/{fileName} {
      allow read: if isAdmin() || isRegularEC();
      allow write: if isAdmin() || isRegularEC();
    }

    match /documents/course/{pathCourseScopeSlug}/{docId}/{fileName} {
      allow read: if canReadCourseDocumentAtPath(docId, pathCourseScopeSlug, fileName);
      allow write: if canWriteCourseDocumentAtPath(docId, pathCourseScopeSlug, fileName);
    }

    match /events/{eventId}/images/{fileId} {
      allow read: if eventExists(eventId) && canViewEventData(eventData(eventId));
      allow create, update: if canEditEventFiles(eventId);
      allow delete: if canEditEventFiles(eventId);
    }

    match /events/{eventId}/images/{imageId}/{fileName} {
      allow read: if canReadEventImageObject(eventId, imageId, fileName);

      // Teachers upload only through callable-created pending metadata at
      // events/{eventId}/images/{imageId}; managers keep their existing path.
      allow create: if canEditEventFiles(eventId) ||
        canCreateOrUpdatePendingEventImage(eventId, imageId, fileName);

      allow update: if canEditEventFiles(eventId) ||
        canCreateOrUpdatePendingEventImage(eventId, imageId, fileName);

      allow delete: if canEditEventFiles(eventId);
    }

    match /events/{eventId}/docs/{fileId} {
      allow read: if canReadEventDocument(eventId);
      allow delete: if canEditEventFiles(eventId);
    }

    match /events/{eventId}/docs/{docId}/{fileName} {
      allow read: if canReadEventDocumentObject(eventId, docId, fileName);

      // Teachers upload only through callable-created pending metadata at
      // events/{eventId}/docs/{docId}; delete remains manager-only.
      allow create: if canEditEventFiles(eventId) ||
        canCreateOrUpdatePendingEventDocument(eventId, docId, fileName);

      allow update: if canEditEventFiles(eventId) ||
        canCreateOrUpdatePendingEventDocument(eventId, docId, fileName);

      allow delete: if canEditEventFiles(eventId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
